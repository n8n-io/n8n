{
	"globalEnv": ["CI", "BUILD_WITH_COVERAGE"],
	"globalPassThroughEnv": ["CODECOV_TOKEN", "COVERAGE_ENABLED", "SENTRY_AUTH_TOKEN"],
	"boundaries": {
		// `~icons/*` is a vite virtual module injected by unplugin-icons (design-system
		// icon barrel), not a real package — declare it so boundaries doesn't flag it.
		"implicitDependencies": ["~icons"]
	},
	"tasks": {
		"clean": { "cache": false },
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"build:unchecked": {
			"dependsOn": ["^build:unchecked"],
			"outputs": ["dist/**"]
		},
		// editor-ui bundles the packages in `sourcePackages` and `modulePackages`
		// (@n8n/frontend-vite-config) from `src`, so it does not wait for their builds. It waits
		// only for the packages it reads from `dist`. The `src` of each source package is in
		// `inputs`, so an edit there still changes the cache key. `editor-ui/vite/turbo-build.test.ts`
		// keeps both lists in step with the tables.
		"n8n-editor-ui#build": {
			"dependsOn": [
				"@n8n/codemirror-lang#build",
				"@n8n/codemirror-lang-html#build",
				"@n8n/codemirror-lang-sql#build",
				"@n8n/eslint-config#build",
				"@n8n/expression-runtime#build",
				"@n8n/frontend-vite-config#build",
				"@n8n/permissions#build",
				"@n8n/playwright-janitor#build",
				"@n8n/stylelint-config#build",
				"@n8n/typescript-config#build",
				"@n8n/vitest-config#build",
				"n8n-workflow#build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/@n8n/api-types/src/**",
				"$TURBO_ROOT$/packages/@n8n/api-types/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/chat/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/chat/package.json",
				"$TURBO_ROOT$/packages/@n8n/chat-hub/src/**",
				"$TURBO_ROOT$/packages/@n8n/chat-hub/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/composables/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/composables/package.json",
				"$TURBO_ROOT$/packages/@n8n/constants/src/**",
				"$TURBO_ROOT$/packages/@n8n/constants/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/design-system/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/design-system/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-constants/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-constants/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-module-sdk/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-module-sdk/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-test-utils/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-test-utils/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-utils/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-utils/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/i18n/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/i18n/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/rest-api-client/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/rest-api-client/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/stores/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/stores/package.json",
				"$TURBO_ROOT$/packages/@n8n/telemetry/src/**",
				"$TURBO_ROOT$/packages/@n8n/telemetry/package.json",
				"$TURBO_ROOT$/packages/@n8n/utils/src/**",
				"$TURBO_ROOT$/packages/@n8n/utils/package.json",
				"$TURBO_ROOT$/packages/modules/type-availability-policies/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/type-availability-policies/frontend/package.json",
				"$TURBO_ROOT$/packages/modules/insights/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/insights/frontend/package.json",
				"$TURBO_ROOT$/packages/modules/instance-registry/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/instance-registry/frontend/package.json",
				"$TURBO_ROOT$/packages/modules/otel/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/otel/frontend/package.json"
			],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"n8n-editor-ui#build:unchecked": {
			"dependsOn": [
				"@n8n/codemirror-lang#build:unchecked",
				"@n8n/codemirror-lang-html#build:unchecked",
				"@n8n/codemirror-lang-sql#build:unchecked",
				"@n8n/eslint-config#build:unchecked",
				"@n8n/expression-runtime#build:unchecked",
				"@n8n/frontend-vite-config#build:unchecked",
				"@n8n/permissions#build:unchecked",
				"@n8n/playwright-janitor#build:unchecked",
				"@n8n/stylelint-config#build:unchecked",
				"@n8n/typescript-config#build:unchecked",
				"@n8n/vitest-config#build:unchecked",
				"n8n-workflow#build:unchecked"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/@n8n/api-types/src/**",
				"$TURBO_ROOT$/packages/@n8n/api-types/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/chat/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/chat/package.json",
				"$TURBO_ROOT$/packages/@n8n/chat-hub/src/**",
				"$TURBO_ROOT$/packages/@n8n/chat-hub/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/composables/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/composables/package.json",
				"$TURBO_ROOT$/packages/@n8n/constants/src/**",
				"$TURBO_ROOT$/packages/@n8n/constants/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/design-system/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/design-system/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-constants/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-constants/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-module-sdk/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-module-sdk/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-test-utils/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-test-utils/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-utils/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/frontend-utils/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/i18n/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/i18n/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/rest-api-client/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/rest-api-client/package.json",
				"$TURBO_ROOT$/packages/frontend/@n8n/stores/src/**",
				"$TURBO_ROOT$/packages/frontend/@n8n/stores/package.json",
				"$TURBO_ROOT$/packages/@n8n/telemetry/src/**",
				"$TURBO_ROOT$/packages/@n8n/telemetry/package.json",
				"$TURBO_ROOT$/packages/@n8n/utils/src/**",
				"$TURBO_ROOT$/packages/@n8n/utils/package.json",
				"$TURBO_ROOT$/packages/modules/type-availability-policies/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/type-availability-policies/frontend/package.json",
				"$TURBO_ROOT$/packages/modules/insights/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/insights/frontend/package.json",
				"$TURBO_ROOT$/packages/modules/instance-registry/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/instance-registry/frontend/package.json",
				"$TURBO_ROOT$/packages/modules/otel/frontend/src/**",
				"$TURBO_ROOT$/packages/modules/otel/frontend/package.json"
			],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		// Both emit declarations only under `RELEASE`, so `RELEASE` has to be part of the cache
		// key. Without it a cached non-release `dist`, which has no `.d.ts`, would be restored
		// onto a release build and ship a package with no types.
		"@n8n/design-system#build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"@n8n/design-system#build:unchecked": {
			"dependsOn": ["^build:unchecked"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"@n8n/chat#build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		"@n8n/chat#build:unchecked": {
			"dependsOn": ["^build:unchecked"],
			"outputs": ["dist/**"],
			"env": ["RELEASE"]
		},
		// The CLI build does not read the editor-ui `dist`: the server finds it at runtime. So
		// `n8n#build` does not wait for `n8n-editor-ui#build`, and a frontend-only change does not
		// rebuild the CLI. `with` keeps `turbo run build --filter=n8n` building the editor too.
		// `packages/cli/test/unit/turbo-build.test.ts` keeps `dependsOn` in step with package.json.
		"n8n#build": {
			"dependsOn": [
				"@n8n/agents#build",
				"@n8n/ai-node-sdk#build",
				"@n8n/ai-utilities#build",
				"@n8n/ai-workflow-builder#build",
				"@n8n/api-types#build",
				"@n8n/backend-common#build",
				"@n8n/backend-network#build",
				"@n8n/backend-test-utils#build",
				"@n8n/blob-storage#build",
				"@n8n/chat-hub#build",
				"@n8n/client-oauth2#build",
				"@n8n/config#build",
				"@n8n/constants#build",
				"@n8n/db#build",
				"@n8n/decorators#build",
				"@n8n/di#build",
				"@n8n/engine#build",
				"@n8n/errors#build",
				"@n8n/expression-runtime#build",
				"@n8n/instance-ai#build",
				"@n8n/mcp-apps#build",
				"@n8n/mcp-browser#build",
				"@n8n/n8n-nodes-langchain#build",
				"@n8n/node-engine-compatibility#build",
				"@n8n/oxlint-config#build",
				"@n8n/permissions#build",
				"@n8n/playwright-janitor#build",
				"@n8n/scheduler#build",
				"@n8n/syslog-client#build",
				"@n8n/task-runner#build",
				"@n8n/telemetry#build",
				"@n8n/typeorm#build",
				"@n8n/typescript-config#build",
				"@n8n/utils#build",
				"@n8n/vitest-config#build",
				"@n8n/workflow-sdk#build",
				"n8n-containers#build",
				"n8n-core#build",
				"n8n-nodes-base#build",
				"n8n-workflow#build"
			],
			"with": ["n8n-editor-ui#build"],
			"outputs": ["dist/**"]
		},
		"n8n#build:unchecked": {
			"dependsOn": [
				"@n8n/agents#build:unchecked",
				"@n8n/ai-node-sdk#build:unchecked",
				"@n8n/ai-utilities#build:unchecked",
				"@n8n/ai-workflow-builder#build:unchecked",
				"@n8n/api-types#build:unchecked",
				"@n8n/backend-common#build:unchecked",
				"@n8n/backend-network#build:unchecked",
				"@n8n/backend-test-utils#build:unchecked",
				"@n8n/blob-storage#build:unchecked",
				"@n8n/chat-hub#build:unchecked",
				"@n8n/client-oauth2#build:unchecked",
				"@n8n/config#build:unchecked",
				"@n8n/constants#build:unchecked",
				"@n8n/db#build:unchecked",
				"@n8n/decorators#build:unchecked",
				"@n8n/di#build:unchecked",
				"@n8n/engine#build:unchecked",
				"@n8n/errors#build:unchecked",
				"@n8n/expression-runtime#build:unchecked",
				"@n8n/instance-ai#build:unchecked",
				"@n8n/mcp-apps#build:unchecked",
				"@n8n/mcp-browser#build:unchecked",
				"@n8n/n8n-nodes-langchain#build:unchecked",
				"@n8n/node-engine-compatibility#build:unchecked",
				"@n8n/oxlint-config#build:unchecked",
				"@n8n/permissions#build:unchecked",
				"@n8n/playwright-janitor#build:unchecked",
				"@n8n/scheduler#build:unchecked",
				"@n8n/syslog-client#build:unchecked",
				"@n8n/task-runner#build:unchecked",
				"@n8n/telemetry#build:unchecked",
				"@n8n/typeorm#build:unchecked",
				"@n8n/typescript-config#build:unchecked",
				"@n8n/utils#build:unchecked",
				"@n8n/vitest-config#build:unchecked",
				"@n8n/workflow-sdk#build:unchecked",
				"n8n-containers#build:unchecked",
				"n8n-core#build:unchecked",
				"n8n-nodes-base#build:unchecked",
				"n8n-workflow#build:unchecked"
			],
			"with": ["n8n-editor-ui#build:unchecked"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"format": {},
		"format:check": {},
		"lint": {
			"dependsOn": ["^build", "@n8n/eslint-config#build"]
		},
		// Oxlint packages run Oxlint instead of ESLint, so
		// they need the oxlint layer built, not the ESLint one.
		"@n8n/ai-node-sdk#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/backend-common#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/backend-services#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/client-oauth2#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/computer-use#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/config#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/crdt#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/decorators#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/di#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/errors#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/imap#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/local-gateway#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/scheduler#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"@n8n/syslog-client#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		"n8n#lint": {
			"dependsOn": ["^build", "@n8n/oxlint-config#build"]
		},
		// The n8n-nodes-base lint script also validates load-options methods
		// against dist/methods/*.json, which only its own build emits.
		"n8n-nodes-base#lint": {
			"dependsOn": ["^build", "build", "@n8n/eslint-config#build"]
		},
		"lint:fix": {},
		"lint:styles": {
			"dependsOn": ["@n8n/stylelint-config#build"]
		},
		"lint:styles:fix": {
			"dependsOn": ["@n8n/stylelint-config#build"]
		},
		"test": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "COVERAGE_SCOPE"],
			"passThroughEnv": ["CHANGED_FILES"]
		},
		"test:changed": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "CHANGED_FILES"],
			"cache": false
		},
		"test:unit": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "COVERAGE_SCOPE"],
			"passThroughEnv": ["CHANGED_FILES"]
		},
		"test:unit:changed": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "CHANGED_FILES"],
			"cache": false
		},
		"test:integration": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "COVERAGE_SCOPE"],
			"passThroughEnv": ["CHANGED_FILES"]
		},
		"test:integration:changed": {
			"dependsOn": ["^build", "build"],
			"outputs": ["coverage/**", "*.xml"],
			"env": ["COVERAGE_ENABLED", "CHANGED_FILES"],
			"cache": false
		},
		"watch": { "cache": false, "persistent": true },
		"dev": { "cache": false, "persistent": true },
		"install-browsers": {
			"cache": true,
			"inputs": [".playwright-version"],
			"outputs": [".playwright-browsers/**"]
		},
		"test:container:standard": {
			"env": ["E2E_TESTS"],
			"cache": false
		}
	}
}
