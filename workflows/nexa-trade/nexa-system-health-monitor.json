      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { service: 'nexa-api', endpoint: 'https://mock.nexa.invalid/health', statusCode: 200, body: { status: 'ok', version: 'mock-1' }, responseTimeMs: 42, observedAt: new Date().toISOString() } }];"
      },
      "id": "1a4d3a10-1c2f-4b62-9a4e-000000000002",
      "name": "Mock approved health response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $json; const valid = input.statusCode === 200 && input.body?.status === 'ok'; return [{ json: { ...input, state: valid ? 'VERIFIED' : 'FAILED', errorCategory: valid ? null : 'invalid_response', alertKey: `${input.service}:health`, retryable: input.statusCode >= 500 || input.statusCode === 0 } }];"
      },
      "id": "1a4d3a10-1c2f-4b62-9a4e-000000000003",
      "name": "Validate and classify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$json, deduplication: { key: $json.alertKey, cooldownMinutes: 15, action: $json.state === 'FAILED' ? 'notify_if_new_or_recovered' : 'record_recovery_or_healthy' }, notification: { mode: 'MOCK_ONLY', destination: 'owner-approved-channel-required' }, executionLog: { recorded: true, sensitiveHeadersLogged: false } } }];"
      },
      "id": "1a4d3a10-1c2f-4b62-9a4e-000000000004",
      "name": "Deduplicate and log",
      "type": "n8n-nodes-base.code",
