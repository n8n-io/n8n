  "name": "Template Vertical",
  "version": "1.0.0",
  "identity": {
    "customer_term": "client",
    "staff_term": "team member",
    "visit_term": "appointment"
  },
  "prompts": {
    "tone": "warm, professional, concise",
    "vocabulary": [],
    "greeting_style": "friendly first-name basis",
    "upsell_rules": [],
    "never_say": []
  },
  "booking": {
    "enabled": true,
    "slot_minutes": 30,
    "buffer_minutes": 0,
    "deposit_required": false,
    "staff_assignment": "any",
