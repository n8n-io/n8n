  "kpis": ["todays_leads", "revenue", "bookings", "missed_calls", "conversion_rate", "repeat_customers", "average_ticket", "open_rate", "reply_rate", "ai_usage"],
  "calendars": { "seasonal_peaks": [] },
  "compliance": {
    "quiet_hours": null,
    "consent_language_required": false,
    "notes": ""
  }
