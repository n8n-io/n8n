+Queue.prototype.n8nWaitForJob = async function() {
+  // A slot whose turn comes after a pause or close must not start a new wait
+  if (this.closing || this.paused) {
+    return;
+  }
+
+  //
+  // Waiting for new jobs to arrive
+  //
+  try {
+    this.bclient.blocked = true;
+    // n8n patch: BRPOPLPUSH moves a job to active before its lock is set. If the
+    // event loop blocks in between, the stall check fails a job that never ran.
+    // BLMOVE to the same list only waits for a job, and moveToActive then claims
+    // and locks it in one script. Redis before 6.2 has no BLMOVE.
+    if (!this.n8nWithoutBlmove) {
+      try {
+        const ready = await this.bclient.blmove(
+          this.keys.wait,
+          this.keys.wait,
+          'RIGHT',
+          'RIGHT',
+          this.settings.drainDelay
+        );
+        this.bclient.blocked = false;
+        return ready ? this.moveToActive() : undefined;
+      } catch (err) {
+        if (!/unknown command/i.test(err.message)) {
+          throw err;
+        }
+        this.n8nWithoutBlmove = true;
       }
     }
-  } else {
