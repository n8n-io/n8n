   end
diff --git a/lib/commands/moveToActive-8.lua b/lib/commands/moveToActive-8.lua
index 1b35186625853cb60529cb8878d26ea6f428c9bb..77e765b4cafddf6f6a399e7c31a93c89bb4174b0 100644
--- a/lib/commands/moveToActive-8.lua
+++ b/lib/commands/moveToActive-8.lua
@@ -115,6 +115,20 @@ end
 local jobId = ARGV[5]
 
 if jobId ~= '' then
+  -- n8n patch: the caller's BRPOPLPUSH completed some time ago, so the stall
+  -- sweep may have returned the job to the queue under a fresh id since. Activate
+  -- only a job that is still in active and that nobody locks right now.
+  local inActive = false
+  for _, activeId in ipairs(rcall("LRANGE", KEYS[2], 0, -1)) do
+    if activeId == jobId then
+      inActive = true
+      break
+    end
+  end
+  if not inActive
+    or not rcall("SET", ARGV[1] .. jobId .. ':lock', ARGV[2], "PX", ARGV[3], "NX") then
+    return
+  end
   -- clean stalled key
   rcall("SREM", KEYS[5], jobId)
 else
