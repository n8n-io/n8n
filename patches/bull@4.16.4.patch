@@ -76,6 +76,30 @@ if(#stalling > 0) then
       local removed = rcall("LREM", KEYS[3], 1, jobId)
 
       if(removed > 0) then
+        -- n8n patch: a job without processedOn reached active through BRPOPLPUSH,
+        -- but Bull never activated it for a worker. It never ran, so it is safe to
+        -- run later. Return it to the queue under a fresh id and drop the old one,
+        -- so the worker that still holds the old id finds nothing to run when it
+        -- wakes up. No stall is counted.
+        if(rcall("HEXISTS", jobKey, "processedOn") == 0) then
+          local newId = rcall("INCR", ARGV[2] .. "id")
+          local newKey = ARGV[2] .. newId
+          local fields = rcall("HGETALL", jobKey)
+          if #fields > 0 then
+            rcall("HMSET", newKey, unpack(fields))
+          end
+          rcall("DEL", jobKey, jobKey .. ":logs")
+          local priorityKey = ARGV[2] .. "priority"
+          local priority = rcall("ZSCORE", priorityKey, jobId)
+          rcall("ZREM", priorityKey, jobId)
+          if priority then
+            rcall("ZADD", priorityKey, priority, newId)
+          end
+          local target = getTargetQueueList(KEYS[6], KEYS[2], KEYS[7])
+          rcall("RPUSH", target, newId)
+          rcall('PUBLISH', KEYS[1] .. '@', newId)
+          table.insert(stalled, newId)
+        else
         -- If this job has been stalled too many times, such as if it crashes the worker, then fail it.
         local stalledCount = rcall("HINCRBY", jobKey, "stalledCounter", 1)
         if(stalledCount > MAX_STALLED_JOB_COUNT) then
