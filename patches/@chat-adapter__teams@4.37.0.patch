+  // n8n patch (upstream: vercel/chat#950) — Teams accepts an update or a delete
+  // for a targeted activity only through ?isTargetedActivity=true; the plain
+  // endpoint answers 400. Nothing on the wire says afterwards which activities
+  // were targeted and editMessage/deleteMessage receive only a message id, so
+  // the ids sent targeted are recorded here and read back on mutation.
+  //
+  // The record is only a fast path. n8n backs the Chat state adapter with
+  // process memory, so a restart or a second main loses it — mutateActivity
+  // therefore tries the other endpoint rather than trusting the lookup.
+  targetedActivityKey(conversationId, messageId) {
+    return `teams:targetedActivity:${conversationId}:${messageId}`;
+  }
+  async rememberTargetedActivity(conversationId, messageId) {
+    if (!(this.chat && messageId)) return;
+    try {
+      await this.chat.getState().set(
+        this.targetedActivityKey(conversationId, messageId),
+        "1",
+        TARGETED_ACTIVITY_TTL_MS
+      );
+    } catch {
+      // A state adapter that cannot write must not fail the send.
+    }
+  }
+  async isTargetedActivity(conversationId, messageId) {
+    if (!(this.chat && messageId)) return false;
+    try {
+      return await this.chat.getState().get(
+        this.targetedActivityKey(conversationId, messageId)
+      ) === "1";
+    } catch {
+      return false;
+    }
+  }
+  async forgetTargetedActivity(conversationId, messageId) {
+    if (!(this.chat && messageId)) return;
+    try {
+      await this.chat.getState().delete(
+        this.targetedActivityKey(conversationId, messageId)
+      );
+    } catch {
+      // The TTL clears it anyway.
+    }
+  }
+  // A lost record must not leave an answered card in the channel, so fall back
+  // to the endpoint we did not pick. A 1:1 chat has no targeted variant, so its
+  // failure is real and propagates.
+  async mutateActivity(threadId, preferTargeted, targetedCall, plainCall) {
+    try {
+      return await (preferTargeted ? targetedCall() : plainCall());
+    } catch (error) {
+      if (this.isDM(threadId)) throw error;
+      return await (preferTargeted ? plainCall() : targetedCall());
+    }
+  }
