			display: flex;
			align-items: center;
			justify-content: center;
			padding: 24px;
		}

		.card { background: #ffffff; border: 1px solid #dbdfe7; border-radius: 8px; padding: 28px 32px; max-width: 420px; text-align: center; }
		h1 { font-size: 20px; line-height: 1.3; }
		p { margin-top: 8px; font-size: 14px; color: #7e8186; }
