<div class='rounded-lg border border-border-danger bg-background-danger p-md mb-md'>
	{{#if preview}}
		<p class='text-text-danger font-medium'>Block failed to render: {{message}}</p>
		{{#if stack}}<pre class='text-2xs overflow-x-auto mt-xs'>{{stack}}</pre>{{/if}}
	{{else}}
		<p class='text-text-danger'>This block failed to load.</p>
	{{/if}}
</div>
