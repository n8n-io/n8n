{{!-- Recurses into `children`, so the menu nests as deeply as the page tree. --}}
<ul class='list-none pl-sm text-sm'>
	{{#each this}}
		<li class='py-2xs'>
			{{#if current}}
				<span class='font-semibold app-text'>{{title}}</span>
			{{else}}
				<a href='{{path}}' class='app-link no-underline hover:underline'>{{title}}</a>
			{{/if}}
			{{#if children.length}}
				{{> appPageMenu children}}
			{{/if}}
		</li>
	{{/each}}
</ul>
