{{!-- Recurses into `children`, so the menu nests as deeply as the page tree. --}}
<ul>
	{{#each this}}
		<li>
			{{#if current}}
				<span class='current-page'>{{title}}</span>
			{{else}}
				<a href='{{path}}'>{{title}}</a>
			{{/if}}
			{{#if children.length}}
				{{> appPageMenu children}}
			{{/if}}
		</li>
	{{/each}}
</ul>
