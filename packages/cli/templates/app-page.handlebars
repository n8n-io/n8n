<!DOCTYPE html>
<html lang='en'>
<!--
	An App page. Served under the sandbox CSP, so this document has an opaque
	origin: no cookies, no localStorage, and its own requests are cross-site.
	Anything dynamic is resolved server-side; the served script (app.js) holds
	the tokens and sends them as a header.
-->

<head>
	<meta charset='UTF-8' />
	<meta name='viewport' content='width=device-width, initial-scale=1.0' />
	<meta name='robots' content='noindex' />
	<meta name='n8n-app-base' content='{{appBase}}' />
	<title>{{title}} · {{appName}}</title>
	<link rel='stylesheet' href='{{cssHref}}' />
	<script src='{{jsHref}}' defer></script>
	{{{themeStyle}}}
</head>

<body class='app-canvas app-text min-h-screen'>
	{{#if layout}}
		{{> appLayout}}
	{{else}}
		<div class='app-shell' data-app-root>
			<nav class='app-menu'>
				<span class='block text-xs font-semibold app-muted uppercase mb-sm'>{{appName}}</span>
				{{> appPageMenu menu}}
			</nav>

			<main class='app-main'>
				{{#each blocks}}{{{this}}}{{/each}}
			</main>
		</div>
	{{/if}}
</body>

</html>
