<mjml>
	<mj-include path="./_common.mjml" />
	<mj-body>
		<mj-section padding="0 20px">
			<mj-column>
				<mj-include path="./_logo.mjml" />
				<mj-text font-size="22px" font-weight="400">Your workflows need changes before the upgrade to n8n {{ targetVersion }}</mj-text>
				<mj-text>Hi {{ firstName }},</mj-text>
				<mj-text>{{ notifierName }} asked you to resolve the migration finding <b>"{{ ruleTitle }}"</b> on the workflows you own. The upgrade to n8n {{ targetVersion }} changes how these workflows behave.</mj-text>
				<mj-text>
					<ul>
						{{#each workflows}}
						<li><a href="{{ this.url }}">{{ this.name }}</a></li>
						{{/each}}
					</ul>
				</mj-text>
				<mj-text>Open the migration report for the details and the steps to fix them.</mj-text>
				<mj-button href="{{reportUrl}}">Open Migration Report</mj-button>
				<mj-include path="./_footer.mjml" />
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
