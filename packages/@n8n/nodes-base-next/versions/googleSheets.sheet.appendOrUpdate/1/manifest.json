{
	"id": "googleSheets.sheet.appendOrUpdate",
	"version": 1,
	"abi": 1,
	"contractHash": "726b33fc0fe6e25cf871d3873f95bd29093cae60794b1052e7531dc439a1a00d",
	"bundleHash": "8fba53ad7c9e7610c6bc3631b658f63fba461ab9a0802aea4ec32a42a14a1cd6",
	"contract": {
		"id": "googleSheets.sheet.appendOrUpdate",
		"version": 1,
		"node": "googleSheets",
		"action": "Append or update row",
		"summary": "Upsert: update the row whose matchOn column equals the value in values, else append.",
		"flow": {
			"effect": "write",
			"cardinality": "per-item",
			"passthrough": "replace",
			"idempotent": true
		},
		"credentials": [
			"googleSheetsOAuth2Api"
		],
		"input": {
			"type": "object",
			"properties": {
				"spreadsheet": {
					"type": "string",
					"pattern": "[-_a-zA-Z0-9]{25,}",
					"x-n8n-hint": "Spreadsheet ID or Google Sheets URL",
					"x-n8n-ref": "googleSheets.spreadsheet"
				},
				"sheet": {
					"type": "object",
					"discriminator": {
						"propertyName": "mode"
					},
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"mode": {
									"const": "name",
									"x-n8n-literal": true
								},
								"name": {
									"type": "string",
									"x-n8n-hint": "Exact tab name the user gave"
								}
							},
							"required": [
								"mode",
								"name"
							],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"mode": {
									"const": "id",
									"x-n8n-literal": true
								},
								"id": {
									"type": "string",
									"pattern": "^(gid=)?[0-9]+$",
									"x-n8n-hint": "A numeric sheet gid"
								}
							},
							"required": [
								"mode",
								"id"
							],
							"additionalProperties": false
						}
					],
					"x-n8n-hint": "Never assume \"Sheet1\"; ask when the tab name is unknown"
				},
				"values": {
					"type": "object",
					"additionalProperties": true,
					"x-n8n-hint": "Header text -> value; keys must equal header cells"
				},
				"matchOn": {
					"type": "string",
					"x-n8n-hint": "Header text of the key column; values must set it"
				},
				"header": {
					"type": "object",
					"properties": {
						"headerRow": {
							"type": "integer",
							"minimum": 1,
							"default": 1
						},
						"firstDataRow": {
							"type": "integer",
							"minimum": 1,
							"default": 2
						}
					},
					"additionalProperties": false
				},
				"cellFormat": {
					"enum": [
						"USER_ENTERED",
						"RAW"
					],
					"default": "USER_ENTERED"
				}
			},
			"required": [
				"spreadsheet",
				"sheet",
				"values",
				"matchOn"
			],
			"additionalProperties": false
		},
		"output": {
			"type": "object",
			"additionalProperties": true,
			"x-n8n-hint": "The values sent, keyed by header text"
		}
	},
	"description": {
		"displayName": "Google Sheets: Append or update row",
		"name": "googleSheetsSheetAppendOrUpdate",
		"group": [
			"output"
		],
		"version": 1,
		"description": "Upsert: update the row whose matchOn column equals the value in values, else append.",
		"defaults": {
			"name": "Append or update row"
		},
		"inputs": [
			"main"
		],
		"outputs": [
			"main"
		],
		"credentials": [
			{
				"name": "googleSheetsOAuth2Api",
				"required": true
			}
		],
		"properties": [
			{
				"displayName": "spreadsheet",
				"name": "spreadsheet",
				"required": true,
				"description": "Spreadsheet ID or Google Sheets URL",
				"type": "string",
				"default": ""
			},
			{
				"displayName": "sheet",
				"name": "sheet",
				"required": true,
				"description": "Never assume \"Sheet1\"; ask when the tab name is unknown",
				"type": "json",
				"default": "{}"
			},
			{
				"displayName": "values",
				"name": "values",
				"required": true,
				"description": "Header text -> value; keys must equal header cells",
				"type": "json",
				"default": "{}"
			},
			{
				"displayName": "matchOn",
				"name": "matchOn",
				"required": true,
				"description": "Header text of the key column; values must set it",
				"type": "string",
				"default": ""
			},
			{
				"displayName": "header",
				"name": "header",
				"required": false,
				"type": "json",
				"default": ""
			},
			{
				"displayName": "cellFormat",
				"name": "cellFormat",
				"required": false,
				"type": "options",
				"options": [
					{
						"name": "USER_ENTERED",
						"value": "USER_ENTERED"
					},
					{
						"name": "RAW",
						"value": "RAW"
					}
				],
				"default": "USER_ENTERED"
			}
		]
	}
}
