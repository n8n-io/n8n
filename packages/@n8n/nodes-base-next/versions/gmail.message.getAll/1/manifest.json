{
	"id": "gmail.message.getAll",
	"version": 1,
	"abi": 1,
	"contractHash": "1113a075be3c1171df8104d174b42ed7f6cb568792eb8477c93c6069735e0aff",
	"bundleHash": "51ec209c27a7ee506cc40970ce9d4bf26f5561bded746300203fae775def83a5",
	"contract": {
		"id": "gmail.message.getAll",
		"version": 1,
		"node": "gmail",
		"action": "Get many messages",
		"summary": "List messages that match a Gmail search.",
		"flow": {
			"effect": "read",
			"cardinality": "1:N",
			"passthrough": "replace",
			"idempotent": true
		},
		"credentials": [
			"gmailOAuth2"
		],
		"input": {
			"type": "object",
			"properties": {
				"filters": {
					"type": "object",
					"properties": {
						"q": {
							"type": "string",
							"x-n8n-hint": "Gmail search syntax, e.g. \"is:unread from:ada@example.com\""
						},
						"readStatus": {
							"enum": [
								"both",
								"unread",
								"read"
							],
							"default": "both"
						},
						"sender": {
							"type": "string"
						},
						"labelIds": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"x-n8n-hint": "Label IDs, not names"
						},
						"receivedAfter": {
							"type": "string",
							"x-n8n-hint": "ISO 8601 date or date-time"
						},
						"receivedBefore": {
							"type": "string",
							"x-n8n-hint": "ISO 8601 date or date-time"
						},
						"includeSpamTrash": {
							"type": "boolean"
						}
					},
					"additionalProperties": false
				},
				"paging": {
					"type": "object",
					"discriminator": {
						"propertyName": "mode"
					},
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"mode": {
									"const": "all",
									"x-n8n-literal": true
								}
							},
							"required": [
								"mode"
							],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"mode": {
									"const": "limit",
									"x-n8n-literal": true
								},
								"max": {
									"type": "integer",
									"minimum": 1,
									"maximum": 500
								}
							},
							"required": [
								"mode",
								"max"
							],
							"additionalProperties": false
						}
					],
					"default": {
						"mode": "limit",
						"max": 50
					}
				}
			},
			"additionalProperties": false
		},
		"output": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"threadId": {
					"type": "string"
				},
				"snippet": {
					"type": "string"
				},
				"historyId": {
					"type": "string"
				},
				"internalDate": {
					"type": "string",
					"x-n8n-hint": "Epoch milliseconds as a string"
				},
				"sizeEstimate": {
					"type": "integer"
				},
				"labels": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string"
							}
						},
						"required": [
							"id",
							"name"
						],
						"additionalProperties": false
					}
				},
				"payload": {
					"type": "object",
					"properties": {
						"mimeType": {
							"type": "string"
						}
					},
					"required": [
						"mimeType"
					],
					"additionalProperties": true
				},
				"From": {
					"type": "string",
					"x-n8n-hint": "A string such as \"Ada <ada@example.com>\""
				},
				"To": {
					"type": "string"
				},
				"Cc": {
					"type": "string"
				},
				"Bcc": {
					"type": "string"
				},
				"Subject": {
					"type": "string"
				}
			},
			"required": [
				"id",
				"threadId",
				"snippet",
				"historyId",
				"internalDate",
				"sizeEstimate"
			],
			"additionalProperties": true,
			"x-n8n-hint": "Metadata and snippet only; no body"
		}
	},
	"description": {
		"displayName": "Gmail: Get many messages",
		"name": "gmailMessageGetAll",
		"group": [
			"input"
		],
		"version": 1,
		"description": "List messages that match a Gmail search.",
		"defaults": {
			"name": "Get many messages"
		},
		"inputs": [
			"main"
		],
		"outputs": [
			"main"
		],
		"credentials": [
			{
				"name": "gmailOAuth2",
				"required": true
			}
		],
		"properties": [
			{
				"displayName": "filters",
				"name": "filters",
				"required": false,
				"type": "json",
				"default": ""
			},
			{
				"displayName": "paging",
				"name": "paging",
				"required": false,
				"type": "json",
				"default": "{\"mode\":\"limit\",\"max\":50}"
			}
		]
	}
}
