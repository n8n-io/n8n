{
	"id": "googleSheets.sheet.append",
	"version": 1,
	"abi": 1,
	"contractHash": "3afa22f44c76d5d84797810a48852c5aab00d6b64e92fde28b6b638a180ac3dc",
	"bundleHash": "f9a2da8f06032a0e3eab18d319e5f82fe8f41a9804b9dbf2ea424dce713554a9",
	"contract": {
		"id": "googleSheets.sheet.append",
		"version": 1,
		"node": "googleSheets",
		"action": "Append row",
		"summary": "Append one row per item. Never updates existing rows; use appendOrUpdate to upsert.",
		"flow": {
			"effect": "write",
			"cardinality": "per-item",
			"passthrough": "replace",
			"idempotent": false
		},
		"credentials": [
			"googleSheetsOAuth2Api"
		],
		"input": {
			"type": "object",
			"properties": {
				"spreadsheet": {
					"type": "string",
					"pattern": "[-_a-zA-Z0-9]{25,}",
					"x-n8n-hint": "Spreadsheet ID or Google Sheets URL",
					"x-n8n-ref": "googleSheets.spreadsheet"
				},
				"sheet": {
					"type": "object",
					"discriminator": {
						"propertyName": "mode"
					},
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"mode": {
									"const": "name",
									"x-n8n-literal": true
								},
								"name": {
									"type": "string",
									"x-n8n-hint": "Exact tab name the user gave"
								}
							},
							"required": [
								"mode",
								"name"
							],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"mode": {
									"const": "id",
									"x-n8n-literal": true
								},
								"id": {
									"type": "string",
									"pattern": "^(gid=)?[0-9]+$",
									"x-n8n-hint": "A numeric sheet gid"
								}
							},
							"required": [
								"mode",
								"id"
							],
							"additionalProperties": false
						}
					],
					"x-n8n-hint": "Never assume \"Sheet1\"; ask when the tab name is unknown"
				},
				"values": {
					"type": "object",
					"additionalProperties": true,
					"x-n8n-hint": "Header text -> value; keys must equal header cells"
				},
				"headerRow": {
					"type": "integer",
					"minimum": 1,
					"default": 1
				},
				"cellFormat": {
					"enum": [
						"USER_ENTERED",
						"RAW"
					],
					"default": "USER_ENTERED"
				}
			},
			"required": [
				"spreadsheet",
				"sheet",
				"values"
			],
			"additionalProperties": false
		},
		"output": {
			"type": "object",
			"additionalProperties": true,
			"x-n8n-hint": "The values sent, keyed by header text"
		}
	},
	"description": {
		"displayName": "Google Sheets: Append row",
		"name": "googleSheetsSheetAppend",
		"group": [
			"output"
		],
		"version": 1,
		"description": "Append one row per item. Never updates existing rows; use appendOrUpdate to upsert.",
		"defaults": {
			"name": "Append row"
		},
		"inputs": [
			"main"
		],
		"outputs": [
			"main"
		],
		"credentials": [
			{
				"name": "googleSheetsOAuth2Api",
				"required": true
			}
		],
		"properties": [
			{
				"displayName": "spreadsheet",
				"name": "spreadsheet",
				"required": true,
				"description": "Spreadsheet ID or Google Sheets URL",
				"type": "string",
				"default": ""
			},
			{
				"displayName": "sheet",
				"name": "sheet",
				"required": true,
				"description": "Never assume \"Sheet1\"; ask when the tab name is unknown",
				"type": "json",
				"default": "{}"
			},
			{
				"displayName": "values",
				"name": "values",
				"required": true,
				"description": "Header text -> value; keys must equal header cells",
				"type": "json",
				"default": "{}"
			},
			{
				"displayName": "headerRow",
				"name": "headerRow",
				"required": false,
				"type": "number",
				"default": 1
			},
			{
				"displayName": "cellFormat",
				"name": "cellFormat",
				"required": false,
				"type": "options",
				"options": [
					{
						"name": "USER_ENTERED",
						"value": "USER_ENTERED"
					},
					{
						"name": "RAW",
						"value": "RAW"
					}
				],
				"default": "USER_ENTERED"
			}
		]
	}
}
