{
	"id": "googleGemini.text.message",
	"version": 1,
	"abi": 1,
	"contractHash": "00d25606fe8bebd2fbc5442a3f155ffe5c699ff71a966ecdb89e34c3d32b4edd",
	"bundleHash": "3e8c7a5479b789cc4f9162416253f3d17c3516ad1336cb10e8f42e7f85835adf",
	"contract": {
		"id": "googleGemini.text.message",
		"version": 1,
		"node": "googleGemini",
		"action": "Message a model",
		"summary": "Send messages to a Gemini model and get its reply as text.",
		"flow": {
			"effect": "read",
			"cardinality": "per-item",
			"passthrough": "replace",
			"idempotent": false
		},
		"credentials": [
			"googlePalmApi"
		],
		"input": {
			"type": "object",
			"properties": {
				"model": {
					"type": "string",
					"x-n8n-hint": "Model ID such as \"models/gemini-2.5-flash\"; never invent one"
				},
				"messages": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"role": {
								"enum": [
									"user",
									"model"
								],
								"default": "user"
							},
							"content": {
								"type": "string"
							}
						},
						"required": [
							"content"
						],
						"additionalProperties": false
					},
					"minItems": 1
				},
				"systemMessage": {
					"type": "string"
				},
				"jsonOutput": {
					"type": "boolean",
					"default": false,
					"x-n8n-hint": "Reply text is JSON; still a string"
				},
				"temperature": {
					"type": "number"
				},
				"maxOutputTokens": {
					"type": "integer",
					"minimum": 1
				}
			},
			"required": [
				"model",
				"messages"
			],
			"additionalProperties": false
		},
		"output": {
			"type": "object",
			"properties": {
				"mergedResponse": {
					"type": "string",
					"x-n8n-hint": "The full reply text"
				},
				"content": {
					"type": "object",
					"properties": {
						"parts": {
							"type": "array",
							"items": {
								"type": "object",
								"additionalProperties": true
							}
						},
						"role": {
							"type": "string"
						}
					},
					"additionalProperties": true
				},
				"finishReason": {
					"type": "string"
				},
				"index": {
					"type": "integer"
				}
			},
			"required": [
				"mergedResponse"
			],
			"additionalProperties": true,
			"x-n8n-hint": "One item per candidate"
		}
	},
	"description": {
		"displayName": "Google Gemini: Message a model",
		"name": "googleGeminiTextMessage",
		"group": [
			"input"
		],
		"version": 1,
		"description": "Send messages to a Gemini model and get its reply as text.",
		"defaults": {
			"name": "Message a model"
		},
		"inputs": [
			"main"
		],
		"outputs": [
			"main"
		],
		"credentials": [
			{
				"name": "googlePalmApi",
				"required": true
			}
		],
		"properties": [
			{
				"displayName": "model",
				"name": "model",
				"required": true,
				"description": "Model ID such as \"models/gemini-2.5-flash\"; never invent one",
				"type": "string",
				"default": ""
			},
			{
				"displayName": "messages",
				"name": "messages",
				"required": true,
				"type": "json",
				"default": "{}"
			},
			{
				"displayName": "systemMessage",
				"name": "systemMessage",
				"required": false,
				"type": "string",
				"default": ""
			},
			{
				"displayName": "jsonOutput",
				"name": "jsonOutput",
				"required": false,
				"description": "Reply text is JSON; still a string",
				"type": "boolean",
				"default": false
			},
			{
				"displayName": "temperature",
				"name": "temperature",
				"required": false,
				"type": "number",
				"default": ""
			},
			{
				"displayName": "maxOutputTokens",
				"name": "maxOutputTokens",
				"required": false,
				"type": "number",
				"default": ""
			}
		]
	}
}
