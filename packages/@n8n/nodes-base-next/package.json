{
  "name": "@n8n/nodes-base-next",
  "version": "0.1.0",
  "private": true,
  "description": "n8n nodes defined as action contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "pnpm watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@n8n/node-sdk": "workspace:*",
    "n8n-workflow": "workspace:*"
  },
  "devDependencies": {
    "@n8n/eslint-config": "workspace:*",
    "@n8n/typescript-config": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "n8n-nodes-base": "workspace:*",
    "typescript": "catalog:typescript",
    "vitest": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/NotionDatabasePageGetAll.node.js",
      "dist/nodes/HttpRequestGet.node.js",
      "dist/nodes/HttpRequestSend.node.js",
      "dist/nodes/GoogleSheetsSheetRead.node.js",
      "dist/nodes/GoogleSheetsSheetAppend.node.js",
      "dist/nodes/GoogleSheetsSheetAppendOrUpdate.node.js",
      "dist/nodes/GmailMessageSend.node.js",
      "dist/nodes/GmailMessageGetAll.node.js",
      "dist/nodes/GmailMessageGet.node.js",
      "dist/nodes/GoogleGeminiTextMessage.node.js"
    ]
  }
}
