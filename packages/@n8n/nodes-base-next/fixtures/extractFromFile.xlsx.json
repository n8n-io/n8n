{
	"executions": [
		{
			"name": "one item per row of the first sheet",
			"params": {
				"file": "data"
			},
			"binary": {
				"data": {
					"data": "",
					"mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
					"fileName": "scores.xlsx"
				}
			},

			"imports": [
				[
					{
						"name": "Ada",
						"score": 3
					},
					{
						"name": "Grace",
						"score": 5
					}
				]
			],
			"output": [
				{
					"name": "Ada",
					"score": 3
				},
				{
					"name": "Grace",
					"score": 5
				}
			]
		},
		{
			"name": "a named sheet without a header row",
			"params": {
				"file": "data",
				"sheet": "Scores",
				"header": false
			},
			"binary": {
				"data": {
					"data": "",
					"mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
					"fileName": "scores.xlsx"
				}
			},

			"imports": [[["name", "score"], ["Ada", 3], ["Grace", 5]]],
			"output": [
				{
					"row": ["name", "score"]
				},
				{
					"row": ["Ada", 3]
				},
				{
					"row": ["Grace", 5]
				}
			]
		}
	]
}
