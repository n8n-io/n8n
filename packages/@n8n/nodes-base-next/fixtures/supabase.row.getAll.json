							{
								"id": 1,
								"plan": "free"
							},
							{
								"id": 2,
								"plan": "free"
							}
						]
					}
				}
			],
			"output": [
				{
					"id": 1,
					"plan": "free"
				},
				{
					"id": 2,
					"plan": "free"
				}
			],
			"credential": {
				"host": "https://acme.supabase.co"
			}
		}
	]
}
