{
	"executions": [
		{
			"name": "limited",
			"params": {
				"table": "customers",
				"filter": {
					"match": "all",
					"conditions": [
						{
							"op": "eq",
							"column": "plan",
							"value": "free"
						}
					]
				},
				"paging": {
					"mode": "limit",
					"max": 2
				}
			},
