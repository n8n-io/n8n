{
  "name": "@n8n/node-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Define n8n nodes as typed action contracts",
  "bin": {
    "n8n-node-next": "./src/cli/n8n-node-next"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./freeze": {
      "types": "./dist/freeze.d.ts",
      "default": "./dist/freeze.js"
    },
    "./publish": {
      "types": "./dist/publish.d.ts",
      "default": "./dist/publish.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "spec/**/*"
  ],
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "pnpm watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "spec:generate": "tsx scripts/spec.ts",
    "spec:check": "tsx scripts/spec.ts --check",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@n8n/utils": "workspace:*",
    "esbuild": "catalog:",
    "n8n-workflow": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:typescript"
  },
  "devDependencies": {
    "@n8n/eslint-config": "workspace:*",
    "@n8n/typescript-config": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "vitest": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
