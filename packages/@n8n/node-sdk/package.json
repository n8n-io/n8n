{
  "name": "@n8n/node-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Define n8n nodes as typed action contracts",
  "bin": {
    "n8n-node-next": "./src/cli/n8n-node-next"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./credentials": {
      "types": "./dist/entry/credentials.d.ts",
      "default": "./dist/entry/credentials.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./host": {
      "types": "./dist/entry/host.d.ts",
      "default": "./dist/entry/host.js"
    },
    "./registry": {
      "types": "./dist/entry/registry.d.ts",
      "default": "./dist/entry/registry.js"
    },
    "./codegen": {
      "types": "./dist/entry/codegen.d.ts",
      "default": "./dist/entry/codegen.js"
    },
    "./mcp": {
      "types": "./dist/lift/mcp.d.ts",
      "default": "./dist/lift/mcp.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    },
    "./publish": {
      "types": "./dist/publish.d.ts",
      "default": "./dist/publish.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./runtimes": {
      "types": "./dist/entry/runtimes.d.ts",
      "default": "./dist/entry/runtimes.js"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "spec/**/*"
  ],
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "pnpm watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsx scripts/node-guest.ts",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck && tsx scripts/node-guest.ts",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "spec:generate": "tsx scripts/spec.ts",
    "spec:check": "tsx scripts/spec.ts --check",
    "jsdoc:check": "tsx scripts/jsdoc-coverage.ts --list",
    "sandbox:build": "tsx scripts/sandbox.ts",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@n8n/utils": "workspace:*",
    "ajv": "^8.18.0",
    "esbuild": "catalog:",
    "n8n-workflow": "workspace:*",
    "oxlint": "catalog:",
    "semver": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:typescript"
  },
  "devDependencies": {
    "@n8n/eslint-config": "workspace:*",
    "@n8n/typescript-config": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "@types/semver": "catalog:",
    "vitest": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
