import { defineNode } from '@n8n/node-sdk';
import { credential } from '@n8n/node-sdk/credentials';

import { __service__Api } from './credentials';

export const node = defineNode({
	id: '__service__',
	displayName: '__Service__',
	credential: credential({ types: [__service__Api] }),
	baseUrl: 'https://api.__slug__.example.com/v1',
});

// Each action of this resource comes from `item.action(...)`. Its id is `__service__.item.<operation>`.
export const item = node.resource('item');
