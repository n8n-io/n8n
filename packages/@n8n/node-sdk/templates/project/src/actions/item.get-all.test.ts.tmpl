import assert from 'node:assert/strict';
import { test } from 'node:test';

import { mockHttp, runAction } from '@n8n/node-sdk/testing';

import { getManyItems } from './item.get-all';

const credential = { type: '__service__Api', data: { apiKey: 'test-key' } };
const first = { id: 'itm_1', name: 'First', ownerId: null };
const second = { id: 'itm_2', name: 'Second', ownerId: 'usr_1' };

test('paging all follows nextCursor to the last page', async () => {
	const fetch = mockHttp([
		// When more routes match, the route with more matching query parameters answers.
		{ path: '/items', reply: { json: { items: [first], nextCursor: 'c2' } } },
		{ path: '/items', query: { cursor: 'c2' }, reply: { json: { items: [second], nextCursor: null } } },
	]);
	const result = await runAction(getManyItems, { input: { paging: { mode: 'all' } }, credential, fetch });
	// Compare the whole result: on failure, the message shows `result.error`.
	assert.deepEqual(result, { ok: true, items: [first, second] });
	// `fetch.calls` records each request. Query values are strings; a JSON body is parsed.
	assert.deepEqual(
		fetch.calls.map((call) => call.query),
		[{ pageSize: '100' }, { pageSize: '100', cursor: 'c2' }],
	);
	assert.equal(fetch.calls[0]?.headers.authorization, 'Bearer test-key');
});

test('a paging limit stops without fetching the next page', async () => {
	const fetch = mockHttp([{ path: '/items', reply: { json: { items: [first, second], nextCursor: 'c2' } } }]);
	const input = { paging: { mode: 'limit', max: 1 } };
	const result = await runAction(getManyItems, { input, credential, fetch });
	assert.deepEqual(result, { ok: true, items: [first] });
	assert.deepEqual(
		fetch.calls.map((call) => call.query),
		[{ pageSize: '1' }],
	);
});

test('returns the status of a failed request', async () => {
	const fetch = mockHttp([{ path: '/items', reply: { status: 401, json: { error: 'unauthorized' } } }]);
	const result = await runAction(getManyItems, { input: {}, credential, fetch });
	assert.equal(result.ok ? undefined : result.error.httpStatus, 401);
});

test('rejects a limit below 1', async () => {
	const input = { paging: { mode: 'limit', max: 0 } };
	const result = await runAction(getManyItems, { input, credential });
	assert.equal(result.ok ? undefined : result.error.path, 'input.paging.max');
});
