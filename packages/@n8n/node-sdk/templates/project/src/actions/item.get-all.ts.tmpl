import { arr, loose, nullable, obj, str } from '@n8n/node-sdk';

import { item } from '../__slug__.node';

// `obj` rejects fields it does not list, so list every field the API returns. An API may leave
// out a field, so `loose` makes each field optional and nullable.
export const itemOutput = loose(
	obj({
		id: str().with({ examples: ['itm_1'] }),
		name: str(),
		ownerId: nullable(str()).hint('null when nobody owns the item'),
	}),
);

// The id is `__service__.item.getAll`, so this file is `actions/item.get-all.ts`.
export const getManyItems = item.action('getAll', {
	action: 'Get many items',
	summary: 'List items, newest first.',
	flow: { effect: 'read', cardinality: '1:N', idempotent: true },
	input: {},
	output: itemOutput,
	// n8n sends the requests of a `list`. It checks each page against `response`, and stops at the
	// `paging` limit, on the last page, and on a repeated cursor. `pages` adds the `paging` input.
	list: {
		path: '/items',
		response: obj({ items: arr(itemOutput), nextCursor: nullable(str()).optional() }),
		items: (page) => page.items,
		pages: {
			style: 'cursor',
			next: (page) => page.nextCursor,
			send: { query: 'cursor' },
			size: { query: 'pageSize', max: 100 },
		},
	},
});
