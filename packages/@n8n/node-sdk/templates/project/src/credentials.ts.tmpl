import { defineCredential } from '@n8n/node-sdk';

export const __service__Api = defineCredential({
	name: '__service__Api',
	displayName: '__Service__ API',
	properties: [
		{
			name: 'apiKey',
			displayName: 'API Key',
			type: 'string',
			typeOptions: { password: true },
			required: true,
		},
	],
	authenticate: { headers: { Authorization: '=Bearer {{$credentials.apiKey}}' } },
	test: { request: { baseURL: 'https://api.__slug__.example.com/v1', url: '/items' } },
});
