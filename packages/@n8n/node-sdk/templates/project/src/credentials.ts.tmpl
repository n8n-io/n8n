import { defineCredential, field } from '@n8n/node-sdk/credentials';

export const __service__Api = defineCredential({
	id: '__service__.token',
	legacyName: '__service__Api',
	version: '1.0.0',
	displayName: '__Service__ API',
	fields: { apiKey: field.secret('API Key') },
	auth: (a) => a.bearer('apiKey'),
});
