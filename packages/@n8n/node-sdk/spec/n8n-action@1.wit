/// The first major of the interface between the n8n host and one frozen action. It stays
/// only so that old bundles run: the host adapter `src/action-api-v1.ts` turns the emitted
/// items into an @2 item stream. New bundles use `n8n-action@2.wit`.
package n8n:action@1.0.0;

interface types {
    /// A JSON value. WIT has no recursive types, so a JSON value crosses as UTF-8 text.
    type json = string;
}

interface http {
    use types.{json};

    enum http-method { GET, POST, PUT, PATCH, DELETE, HEAD }

    variant http-target {
        url(string),
        path(string),
    }

    record http-request {
        method: http-method,
        target: http-target,
        query: list<tuple<string, string>>,
        headers: list<tuple<string, string>>,
        body: option<json>,
        timeout-ms: option<u32>,
        retry: option<bool>,
    }

    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: json,
    }

    record http-error {
        message: string,
        status: u16,
        headers: list<tuple<string, string>>,
        body: json,
    }

    variant http-failure {
        response(http-error),
        transport(string),
    }

    request: func(request: http-request) -> result<http-response, http-failure>;
}

interface action {
    use types.{json};
    use http.{http-error};

    record run-error {
        message: string,
        response: option<http-error>,
    }

    describe: func() -> json;

    /// The run for one input item. It calls `emit` for each output item of any cardinality.
    run: func(input: json) -> result<_, run-error>;
}

world bundle {
    use types.{json};

    import http;
    /// Gives one output item for the current input item.
    import emit: func(item: json);
    export action;
}
