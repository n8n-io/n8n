/// The Node Contract: the interface between the n8n host and the code of one bundle. Each
/// kind that runs code has a world in this package: `action`, `trigger`, `credential`,
/// `provider` and `lookup`. This file has the interfaces that the host gives (the
/// capabilities) and the types that more than one world uses.
///
/// The package version is the Node Contract version, the one version of the whole spec. The
/// manifest format (`../manifest.schema.json`) has the same version. A minor adds an optional
/// import, export or field. A major breaks. `@since` tells which minor added an item. A
/// bundle states the lowest version that has all it uses (`nodeContract` in its manifest), so
/// an older host still runs it.
package n8n:node-contract@2.6.0;

@since(version = 2.0.0)
interface types {
    /// A JSON value. WIT has no recursive types, so a JSON value crosses as UTF-8 text.
    type json = string;
}

/// The only network access of a bundle. The host applies the credential, the SSRF policy,
/// the retries and the request limit. The host refuses a request to a host outside the
/// manifest egress or outside the hosts of the credential, with `http-failure.transport`. It
/// checks each page the same way. It checks each redirect hop against the credential hosts and
/// the action hosts. A host from `fromInput` does not limit redirect hops; the credential
/// hosts do.
@since(version = 2.0.0)
interface http {
    use types.{json};

    enum http-method { GET, POST, PUT, PATCH, DELETE, HEAD }

    variant http-target {
        /// An absolute http or https URL, for example a `next` link.
        url(string),
        /// Starts with one `/` and goes after the base URL path. It cannot change the origin.
        path(string),
    }

    record http-request {
        method: http-method,
        target: http-target,
        /// A repeated name sends each value: `id=a&id=b`.
        query: list<tuple<string, string>>,
        headers: list<tuple<string, string>>,
        /// Sent as JSON.
        body: option<json>,
        /// 300000 (5 minutes) when none.
        timeout-ms: option<u32>,
        /// None: the host retries a 429, 502, 503, 504 or a dropped connection for GET,
        /// HEAD, PUT, or an action with `flow.idempotent`. True or false overrides this.
        retry: option<bool>,
    }

    record http-response {
        status: u16,
        /// Lower-case names.
        headers: list<tuple<string, string>>,
        /// The JSON body, or the body text as a JSON string.
        body: json,
    }

    /// A non-2xx response.
    record http-error {
        message: string,
        status: u16,
        /// Lower-case names.
        headers: list<tuple<string, string>>,
        body: json,
    }

    variant http-failure {
        response(http-error),
        /// No response: DNS, connection, TLS, time-out, a host limit, or a refused host.
        transport(string),
    }

    request: func(request: http-request) -> result<http-response, http-failure>;
}

/// The error that ends a run of guest code.
@since(version = 2.0.0)
interface errors {
    use http.{http-error};

    record run-error {
        message: string,
        /// The failed response, when a request caused the error.
        response: option<http-error>,
    }
}

@since(version = 2.0.0)
interface log {
    enum level { debug, info, warn, error }

    /// Writes to the n8n log with the node name. Do not log credentials or personal data.
    /// The host keeps the first 100 lines of a node execution, each cut to 2000 characters.
    log: func(level: level, message: string);
}

/// The credential of the run without its secrets. The host never gives a secret field, a token,
/// or a field that the credential type does not declare.
@since(version = 2.5.0)
interface run-credential {
    use types.{json};

    record run-credential {
        /// The n8n credential type, for example `slackApi`.
        %type: string,
        /// The declared fields that are not secret, as one object.
        fields: json,
    }

    /// None when the run has no credential. An error when the stored data does not match the
    /// declared fields, so only a bundle that reads the credential fails.
    get: func() -> result<option<run-credential>, string>;
}

@since(version = 2.0.0)
interface limits {
    /// The limits for one run: one input item, or all input items of a `batch` run. The host
    /// enforces them.
    record run-limits {
        /// A page is one request.
        max-requests: u32,
        max-items: u32,
    }

    get: func() -> run-limits;
}

/// Binary data stays in the host. A bundle holds a handle and never gets all the bytes at
/// once. Only an action with a `t.binary()` field in its manifest gets it.
///
/// At a `t.binary()` position of the manifest schema, the JSON of the run input and of each
/// output item holds `{ "$binary": <id> }`. `open` gives the handle of an input id, and
/// `binary.id` gives the id to put into an output item. A binary output field must be a
/// top-level field: the host moves it to the `binary` part of the n8n item.
@since(version = 2.2.0)
interface binary {
    use http.{http-method, http-target, http-request, http-response, http-failure};

    record binary-meta {
        mime-type: string,
        file-name: option<string>,
        /// The size in bytes. None when the host does not know it.
        bytes: option<u64>,
    }

    resource binary {
        meta: func() -> binary-meta;
        /// Opens a new reader at the first byte.
        reader: func() -> binary-reader;
        /// The id of this binary in the JSON of an output item.
        id: func() -> u64;
    }

    /// The binary that the run input names with `{ "$binary": id }`.
    open: func(id: u64) -> result<binary, string>;

    resource binary-reader {
        /// At most `max-bytes`. An empty list is the end.
        read: func(max-bytes: u32) -> result<list<u8>, string>;
    }

    /// Creates a binary from chunks. The host stores each chunk when it arrives.
    resource binary-writer {
        constructor(mime-type: string, file-name: option<string>);
        write: func(chunk: list<u8>) -> result<_, string>;
        /// The writer closes. The host keeps the binary for the execution.
        finish: static func(writer: binary-writer) -> result<binary, string>;
    }

    record binary-response {
        status: u16,
        /// Lower-case names.
        headers: list<tuple<string, string>>,
        body: binary,
    }

    /// An `http-request` without `body`: the binary is the body.
    record binary-request {
        method: http-method,
        target: http-target,
        query: list<tuple<string, string>>,
        headers: list<tuple<string, string>>,
        timeout-ms: option<u32>,
        retry: option<bool>,
    }

    /// Sends `body` as the request body, with its MIME type as `content-type` unless
    /// `headers` set one. The host opens the binary again for a retry.
    send: func(request: binary-request, body: borrow<binary>) -> result<http-response, http-failure>;

    /// Keeps the response body in the host as a binary. With `body`, the binary is the
    /// request body and `request.body` must be none.
    fetch: func(request: http-request, body: option<borrow<binary>>) -> result<binary-response, http-failure>;
}

/// The n8n data tables of the project that owns the workflow. A date cell crosses as ISO 8601
/// text; the host converts it for a date column. Only an action that lists `dataTables` in
/// its manifest `imports` gets it.
@since(version = 2.3.0)
interface data-tables {
    use types.{json};

    enum column-type { %string, number, boolean, date }

    record column {
        name: string,
        %type: column-type,
    }

    /// A table by its ID, or by its name in the project of the workflow.
    variant table-ref {
        id(string),
        name(string),
    }

    enum operator { eq, neq, like, ilike, gt, gte, lt, lte, is-empty, is-not-empty }

    record condition {
        column: string,
        op: operator,
        /// A cell value. None for `is-empty` and `is-not-empty`.
        value: option<json>,
    }

    enum match { all, any }

    record filter {
        match: match,
        conditions: list<condition>,
    }

    enum direction { asc, desc }

    record sort {
        column: string,
        direction: direction,
    }

    record row-query {
        filter: option<filter>,
        sort: option<sort>,
        offset: option<u32>,
        /// The most rows of one page.
        limit: u32,
    }

    record row-page {
        /// All rows that the filter matches.
        count: u64,
        /// Each row is an object: `id`, `createdAt`, `updatedAt`, and one field per column.
        rows: list<json>,
    }

    resource table {
        id: func() -> string;
        columns: func() -> result<list<column>, string>;
        rows: func(query: row-query) -> result<row-page, string>;
        /// One write for all rows. Gives the rows with their system columns.
        insert: func(rows: list<json>) -> result<list<json>, string>;
        /// Sets `values` on each row that the filter matches. Gives the changed rows.
        update: func(filter: filter, values: json) -> result<list<json>, string>;
        /// `update`, or one new row when the filter matches no row.
        upsert: func(filter: filter, values: json) -> result<list<json>, string>;
        /// Gives the deleted rows.
        delete: func(filter: filter) -> result<list<json>, string>;
        /// Deletes every row. Gives how many it deleted.
        clear: func() -> result<u64, string>;
        rename: func(name: string) -> result<bool, string>;
        /// Deletes the table and its rows.
        drop: func() -> result<bool, string>;
    }

    /// A table without its rows. Dates are ISO 8601 text.
    record table-info {
        id: string,
        name: string,
        columns: list<column>,
        created-at: string,
        updated-at: string,
    }

    enum table-field { name, created-at, updated-at }

    record table-sort {
        by: table-field,
        direction: direction,
    }

    record list-query {
        /// Tables whose name matches, without case.
        name: option<string>,
        sort: option<table-sort>,
        offset: option<u32>,
        limit: u32,
    }

    record table-page {
        count: u64,
        tables: list<table-info>,
    }

    record new-table {
        name: string,
        columns: list<column>,
    }

    open: func(table: table-ref) -> result<table, string>;
    /// `list` is a WIT keyword. The JSON-RPC method is `data-tables.list`.
    %list: func(query: list-query) -> result<table-page, string>;
    create: func(table: new-table) -> result<table-info, string>;
}

/// User code in the n8n task runner, as the Code node runs it. The code reads the input items
/// of the node. Only an action that lists `code` in its manifest `imports` gets it.
@since(version = 2.3.0)
interface code {
    use types.{json};

    enum language { javascript, python }

    /// `all`: one run that reads every input item. `each`: one run for each input item.
    enum mode { all, each }

    record code-request {
        language: language,
        code: string,
        mode: mode,
    }

    /// What the code returns, not checked. For `each`, a list with one value for each item.
    run: func(request: code-request) -> result<json, string>;
}

/// Only an action that lists `wait` in its manifest `imports` gets it.
@since(version = 2.3.0)
interface wait {
    /// The outputs of this run continue at `at` (milliseconds since the epoch), not before.
    /// The host can suspend the execution after the run.
    until: func(at: u64) -> result<_, string>;
}

/// The input of one item of a `batch` run. Only an action that lists `inputOf` in its
/// manifest `imports` gets it.
@since(version = 2.3.0)
interface input-of {
    use types.{json};

    /// The host resolved, defaulted and validated the input for the item at this index.
    get: func(item: u32) -> result<json, string>;
}

/// The capabilities that a provider supplies to a root node, one resource per kind. The
/// `provider` world exports this interface. The `action` world imports it, so a root action
/// calls a capability through the host. The types do not depend on the provider: each
/// provider adapts its own API, and every root node works with every provider.
@since(version = 2.3.0)
interface capabilities {
    use types.{json};
    use errors.{run-error};

    /// A tool call that a model asks for. `args` match the input schema of the tool.
    record tool-call {
        /// The provider's call ID. A tool result names it.
        id: string,
        name: string,
        args: json,
    }

    record assistant-message {
        content: string,
        tool-calls: option<list<tool-call>>,
    }

    record tool-message {
        tool-call-id: string,
        name: string,
        /// The tool result as text, usually JSON.
        content: string,
    }

    /// One message of a chat, oldest first.
    variant chat-message {
        system(string),
        user(string),
        assistant(assistant-message),
        tool(tool-message),
    }

    /// What a model reads about a tool.
    record tool-definition {
        /// Letters, digits, `_` and `-` only: providers refuse other names.
        name: string,
        description: string,
        /// A JSON Schema object for `args`.
        input: json,
    }

    record chat-request {
        messages: list<chat-message>,
        /// Tools the model may call. A reply with tool calls has no final text.
        tools: option<list<tool-definition>>,
        /// The reply text is JSON that matches this JSON Schema. The provider enforces it when
        /// it can.
        output: option<json>,
    }

    record chat-usage {
        input-tokens: u32,
        output-tokens: u32,
    }

    record chat-reply {
        text: string,
        tool-calls: list<tool-call>,
        /// `stop`, `length`, `tool_calls`, `content_filter`, or a reason of the provider.
        finish-reason: string,
        usage: option<chat-usage>,
    }

    /// A chat model with its settings applied.
    resource chat-model {
        /// The provider model ID, for example `gpt-5-mini`.
        model: func() -> string;
        chat: func(request: chat-request) -> result<chat-reply, run-error>;
    }

    /// The chat history of one session.
    resource memory {
        /// The messages so far, oldest first.
        load: func() -> result<list<chat-message>, run-error>;
        /// Adds the messages of one turn.
        save: func(messages: list<chat-message>) -> result<_, run-error>;
    }

    /// A tool that a model can call.
    resource tool {
        name: func() -> string;
        description: func() -> string;
        /// A JSON Schema object for `args`.
        input: func() -> json;
        /// Runs the tool. The result goes back to the model as JSON.
        call: func(args: json) -> result<json, run-error>;
    }

    resource embeddings {
        /// One vector per text, in order.
        embed: func(texts: list<string>) -> result<list<list<f64>>, run-error>;
    }

    variant capability {
        chat-model(chat-model),
        memory(memory),
        tool(tool),
        embeddings(embeddings),
    }
}

/// The capabilities of the providers that are connected to a root action. Only an action with a
/// `provider.input()` field gets it.
///
/// At a `provider.input()` position of the manifest schema, the JSON of the run input holds
/// `{ "$capability": <id> }`. `open` gives the capability of an id.
@since(version = 2.3.0)
interface supplied {
    use capabilities.{capability};

    open: func(id: u64) -> result<capability, string>;
}
