package n8n:node-contract@2.13.0;

/// What the bundle of a credential type with code exports. The manifest `hooks` list the exports
/// of a bundle, and the host calls no other export. `sign`, `exchange` and `refresh` are the code of
/// a `custom` scheme, and only they get the secret fields of a credential.
@since(version = 2.5.0)
interface credential {
    use types.{json};
    use http.{http-method};

    /// The final request: the host made the URL from the base URL and the target.
    record signed-request {
        method: http-method,
        /// An absolute https URL.
        url: string,
        query: list<tuple<string, string>>,
        headers: list<tuple<string, string>>,
        body: option<json>,
    }

    /// Adds the credential to one request. `fields` are the stored fields, with the defaults
    /// filled in. The host checks the URL of the result against the credential hosts again.
    sign: func(fields: json, request: signed-request) -> result<signed-request, string>;

    /// A token from an exchange. The host keeps it for the credential.
    @unstable(feature = credential-exchange)
    record token {
        /// The fields that `sign` reads, for example `{ "sessionId": "…" }`.
        fields: json,
        /// Seconds until the token expires. None: until a request fails with a `refreshOn`
        /// status.
        expires-in: option<u32>,
    }

    /// Trades the stored fields for a short-lived token, for example a session login.
    @unstable(feature = credential-exchange)
    exchange: func(fields: json) -> result<token, string>;

    /// Gets a new token when the old one expired.
    @unstable(feature = credential-exchange)
    refresh: func(fields: json, previous: token) -> result<token, string>;

    /// What `derive` gives from the fields. The host runs it, e.g. the OAuth2 flow, after it
    /// checks it: each URL is https, and each host comes from a manifest host or a URL field.
    // Not unstable: wit-parser refuses `option<string>` that an excluded type defines first.
    @since(version = 2.13.0)
    record derived {
        authorization-endpoint: option<string>,
        token-endpoint: option<string>,
        /// The exact scope text that n8n sends, e.g. comma-joined for GitHub.
        scope: option<string>,
        authorization-query: list<tuple<string, string>>,
        claims: list<tuple<string, string>>,
        base-url: option<string>,
        hosts: list<string>,
    }

    /// Derives data that the host runs from the stored fields. `fields` are the stored fields
    /// without secrets, with the defaults filled in. It has no capability.
    @unstable(feature = credential-derive)
    derive: func(fields: json) -> result<derived, string>;
}

/// A credential type with code. Its only capability is `http`, for `exchange` and `refresh`.
@since(version = 2.5.0)
world credential-bundle {
    import http;
    export credential;
}
