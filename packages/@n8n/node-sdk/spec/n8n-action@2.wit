/// The interface between the n8n host and one frozen action. It is the source of truth for
/// every runtime: inline JS, a WASM component, a process, and a container. `json-rpc.md`
/// gives the JSON form of each type for the process and container runtimes.
///
/// The package version is the `apiVersion` of a bundle, independent of the n8n version. A
/// minor adds an optional import or field. A major breaks. The host implements 2.4.0. A
/// bundle targets the lowest minor that has what its contract declares: 2.4.0 for a `list`
/// binding or a `pageValue()` input, 2.3.0 for host imports, named inputs or sub-node
/// capabilities, 2.2.0 for binary data, else 2.1.0, so an older host still runs it. The sub-node
/// capability exports and the declarative bindings (`request`, `list`) are not in this file yet.
package n8n:action@2.4.0;

@since(version = 2.0.0)
interface types {
    /// A JSON value. WIT has no recursive types, so a JSON value crosses as UTF-8 text.
    type json = string;
}

/// The only network access of an action. The host applies the node credential, the SSRF
/// policy, the retries and the request limit. The host refuses a request to a host outside
/// the contract egress or outside the hosts of the credential, with
/// `http-failure.transport`. It checks each page the same way. It checks each redirect hop
/// against the credential hosts and the action hosts. A host from `fromInput` does not limit
/// redirect hops; the credential hosts do.
@since(version = 2.0.0)
interface http {
    use types.{json};

    enum http-method { GET, POST, PUT, PATCH, DELETE, HEAD }

    variant http-target {
        /// An absolute http or https URL, for example a `next` link.
        url(string),
        /// Starts with one `/` and goes after the base URL path. It cannot change the origin.
        path(string),
    }

    record http-request {
        method: http-method,
        target: http-target,
        /// A repeated name sends each value: `id=a&id=b`.
        query: list<tuple<string, string>>,
        headers: list<tuple<string, string>>,
        /// Sent as JSON.
        body: option<json>,
        /// 300000 (5 minutes) when none.
        timeout-ms: option<u32>,
        /// None: the host retries a 429, 502, 503, 504 or a dropped connection for GET,
        /// HEAD, PUT, or an action with `flow.idempotent`. True or false overrides this.
        retry: option<bool>,
    }

    record http-response {
        status: u16,
        /// Lower-case names.
        headers: list<tuple<string, string>>,
        /// The JSON body, or the body text as a JSON string.
        body: json,
    }

    /// A non-2xx response.
    record http-error {
        message: string,
        status: u16,
        /// Lower-case names.
        headers: list<tuple<string, string>>,
        body: json,
    }

    variant http-failure {
        response(http-error),
        /// No response: DNS, connection, TLS, time-out, a host limit, or a refused host.
        transport(string),
    }

    request: func(request: http-request) -> result<http-response, http-failure>;
}

@since(version = 2.0.0)
interface log {
    enum level { debug, info, warn, error }

    /// Writes to the n8n log with the node name. Do not log credentials or personal data.
    /// The host keeps the first 100 lines of a node execution, each cut to 2000 characters.
    log: func(level: level, message: string);
}

@since(version = 2.0.0)
interface limits {
    /// The limits for one run: one input item, or all input items of a `batch` run. The host
    /// enforces them.
    record run-limits {
        /// A page is one request.
        max-requests: u32,
        max-items: u32,
    }

    get: func() -> run-limits;
}

/// What the action exports.
@since(version = 2.0.0)
interface action {
    use types.{json};
    use http.{http-error};

    record run-error {
        message: string,
        /// The failed response, when a request caused the error.
        response: option<http-error>,
    }

    /// The contract document: id, version, flow, credentials, input and output schema.
    describe: func() -> json;

    /// The run for one input item.
    resource run {
        /// The host resolved, defaulted and validated `input` against the contract input.
        constructor(input: json);
        /// The next output item, or none at the end. A `per-item` action gives one item.
        /// The host validates each item against the contract output.
        next: func() -> result<option<json>, run-error>;
    }

    /// One output of an `item-run`.
    @since(version = 2.1.0)
    variant output {
        /// A new item from the current input item of a `per-item` or `1:N` run.
        item(json),
        /// The input item at this index, passed on unchanged with its binary data.
        passed(u32),
        /// A new item of a `batch` run, made from the input items at these indexes.
        made(tuple<json, list<u32>>),
    }

    @since(version = 2.1.0)
    record routed-output {
        /// One of the named outputs of the contract. None when the contract has none.
        to: option<string>,
        output: output,
    }

    /// The run that reads input items. A `per-item` or `1:N` action runs once per input item,
    /// with that item as the only entry of `items`. A `batch` action runs once with all items
    /// and the input of the first item. The host runs `item-run` for a bundle of 2.1.0 or newer.
    @since(version = 2.1.0)
    resource item-run {
        constructor(input: json, items: list<json>);
        /// The next output, or none at the end. The host validates each item against the
        /// contract output, and checks each index and output name.
        next: func() -> result<option<routed-output>, run-error>;
    }

    /// An item of one of the named inputs.
    @since(version = 2.3.0)
    record item-ref {
        /// The index of the input in the contract `inputs`.
        input: u32,
        item: u32,
    }

    /// One output of a `join-run`.
    @since(version = 2.3.0)
    variant join-output {
        /// The input item, passed on unchanged with its binary data.
        passed(item-ref),
        /// A new item, made from these input items.
        made(tuple<json, list<item-ref>>),
    }

    @since(version = 2.3.0)
    record routed-join-output {
        to: option<string>,
        output: join-output,
    }

    /// The run of an action with named inputs: one run with the items of each input, in the
    /// order of the contract `inputs`, and the input of the first item of the first input.
    @since(version = 2.3.0)
    resource join-run {
        constructor(input: json, inputs: list<list<json>>);
        next: func() -> result<option<routed-join-output>, run-error>;
    }
}

/// Binary data stays in the host. An action holds a handle and never gets all the bytes at
/// once. Only an action with a `binary()` field in its contract targets 2.2.0 and gets it.
///
/// At a `binary()` position of the contract schema, the JSON of the `run` or `item-run` input
/// and of each output item holds `{ "$binary": <id> }`. `open` gives the handle of an input id, and
/// `binary.id` gives the id to put into an output item. A binary output field must be a
/// top-level field: the host moves it to the `binary` part of the n8n item.
@since(version = 2.2.0)
interface binary {
    use http.{http-method, http-target, http-request, http-response, http-failure};

    record binary-meta {
        mime-type: string,
        file-name: option<string>,
        /// The size in bytes. None when the host does not know it.
        bytes: option<u64>,
    }

    resource binary {
        meta: func() -> binary-meta;
        /// Opens a new reader at the first byte.
        reader: func() -> binary-reader;
        /// The id of this binary in the JSON of an output item.
        id: func() -> u64;
    }

    /// The binary that the run input names with `{ "$binary": id }`.
    open: func(id: u64) -> result<binary, string>;

    resource binary-reader {
        /// At most `max-bytes`. An empty list is the end.
        read: func(max-bytes: u32) -> result<list<u8>, string>;
    }

    /// Creates a binary from chunks. The host stores each chunk when it arrives.
    resource binary-writer {
        constructor(mime-type: string, file-name: option<string>);
        write: func(chunk: list<u8>) -> result<_, string>;
        /// The writer closes. The host keeps the binary for the execution.
        finish: static func(writer: binary-writer) -> result<binary, string>;
    }

    record binary-response {
        status: u16,
        /// Lower-case names.
        headers: list<tuple<string, string>>,
        body: binary,
    }

    /// An `http-request` without `body`: the binary is the body.
    record binary-request {
        method: http-method,
        target: http-target,
        query: list<tuple<string, string>>,
        headers: list<tuple<string, string>>,
        timeout-ms: option<u32>,
        retry: option<bool>,
    }

    /// Sends `body` as the request body, with its MIME type as `content-type` unless
    /// `headers` set one. The host opens the binary again for a retry.
    send: func(request: binary-request, body: borrow<binary>) -> result<http-response, http-failure>;

    /// Keeps the response body in the host as a binary. With `body`, the binary is the
    /// request body and `request.body` must be none.
    fetch: func(request: http-request, body: option<borrow<binary>>) -> result<binary-response, http-failure>;
}

/// The n8n data tables of the project that owns the workflow. A date cell crosses as ISO 8601
/// text; the host converts it for a date column. Only an action that lists `dataTables` in
/// its contract `imports` gets it.
@since(version = 2.3.0)
interface data-tables {
    use types.{json};

    enum column-type { %string, number, boolean, date }

    record column {
        name: string,
        %type: column-type,
    }

    /// A table by its ID, or by its name in the project of the workflow.
    variant table-ref {
        id(string),
        name(string),
    }

    enum operator { eq, neq, like, ilike, gt, gte, lt, lte, is-empty, is-not-empty }

    record condition {
        column: string,
        op: operator,
        /// A cell value. None for `is-empty` and `is-not-empty`.
        value: option<json>,
    }

    enum match { all, any }

    record filter {
        match: match,
        conditions: list<condition>,
    }

    enum direction { asc, desc }

    record sort {
        column: string,
        direction: direction,
    }

    record row-query {
        filter: option<filter>,
        sort: option<sort>,
        offset: option<u32>,
        /// The most rows of one page.
        limit: u32,
    }

    record row-page {
        /// All rows that the filter matches.
        count: u64,
        /// Each row is an object: `id`, `createdAt`, `updatedAt`, and one field per column.
        rows: list<json>,
    }

    resource table {
        id: func() -> string;
        columns: func() -> result<list<column>, string>;
        rows: func(query: row-query) -> result<row-page, string>;
        /// One write for all rows. Gives the rows with their system columns.
        insert: func(rows: list<json>) -> result<list<json>, string>;
        /// Sets `values` on each row that the filter matches. Gives the changed rows.
        update: func(filter: filter, values: json) -> result<list<json>, string>;
        /// `update`, or one new row when the filter matches no row.
        upsert: func(filter: filter, values: json) -> result<list<json>, string>;
        /// Gives the deleted rows.
        delete: func(filter: filter) -> result<list<json>, string>;
        /// Deletes every row. Gives how many it deleted.
        clear: func() -> result<u64, string>;
        rename: func(name: string) -> result<bool, string>;
        /// Deletes the table and its rows.
        drop: func() -> result<bool, string>;
    }

    /// A table without its rows. Dates are ISO 8601 text.
    record table-info {
        id: string,
        name: string,
        columns: list<column>,
        created-at: string,
        updated-at: string,
    }

    enum table-field { name, created-at, updated-at }

    record table-sort {
        by: table-field,
        direction: direction,
    }

    record list-query {
        /// Tables whose name matches, without case.
        name: option<string>,
        sort: option<table-sort>,
        offset: option<u32>,
        limit: u32,
    }

    record table-page {
        count: u64,
        tables: list<table-info>,
    }

    record new-table {
        name: string,
        columns: list<column>,
    }

    open: func(table: table-ref) -> result<table, string>;
    list: func(query: list-query) -> result<table-page, string>;
    create: func(table: new-table) -> result<table-info, string>;
}

/// User code in the n8n task runner, as the Code node runs it. The code reads the input items
/// of the node. Only an action that lists `code` in its contract `imports` gets it.
@since(version = 2.3.0)
interface code {
    use types.{json};

    enum language { javascript, python }

    /// `all`: one run that reads every input item. `each`: one run for each input item.
    enum mode { all, each }

    record code-request {
        language: language,
        code: string,
        mode: mode,
    }

    /// What the code returns, not checked. For `each`, a list with one value for each item.
    run: func(request: code-request) -> result<json, string>;
}

/// Only an action that lists `wait` in its contract `imports` gets it.
@since(version = 2.3.0)
interface wait {
    /// The outputs of this run continue at `at` (milliseconds since the epoch), not before.
    /// The host can suspend the execution after the run.
    until: func(at: u64) -> result<_, string>;
}

/// The input of one item of a `batch` run. Only an action that lists `inputOf` in its
/// contract `imports` gets it.
@since(version = 2.3.0)
interface input-of {
    use types.{json};

    /// The host resolved, defaulted and validated the input for the item at this index.
    get: func(item: u32) -> result<json, string>;
}

world bundle {
    import http;
    import log;
    import limits;
    @since(version = 2.2.0)
    import binary;
    @since(version = 2.3.0)
    import data-tables;
    @since(version = 2.3.0)
    import code;
    @since(version = 2.3.0)
    import wait;
    @since(version = 2.3.0)
    import input-of;
    export action;
}
