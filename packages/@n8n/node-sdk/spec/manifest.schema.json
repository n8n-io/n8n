							"type": "array",
							"items": {
								"type": "string",
								"pattern": "^[^.@]+\\.[^.@]+@\\d+$"
							},
							"description": "`<id>@<major>` of each credential type with a credential manifest."
						}
					],
					"x-n8n-since": "2.5.0"
				},
				"errorOf": {
					"type": "string",
					"pattern": "^=",
					"description": "The n8n expression that finds an error in a successful response.",
