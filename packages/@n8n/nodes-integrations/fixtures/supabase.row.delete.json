{
	"executions": [
		{
			"name": "churned and free",
			"params": {
				"table": "customers",
				"filter": {
					"match": "all",
					"conditions": [
						{
							"op": "eq",
							"column": "status",
							"value": "churned"
						},
						{
							"op": "eq",
							"column": "plan",
							"value": "free"
						}
					]
				}
			},
			"routes": [
				{
					"method": "DELETE",
					"path": "/rest/v1/customers",
					"reply": {
						"json": [
							{
								"id": 3,
								"email": "c@example.com",
								"status": "churned",
								"plan": "free"
							}
						]
					}
				}
			],
			"output": [
				{
					"id": 3,
					"email": "c@example.com",
					"status": "churned",
					"plan": "free"
				}
			],
			"credential": {
				"host": "https://acme.supabase.co"
			}
		},
		{
			"name": "nothing matched",
			"params": {
				"table": "customers",
				"filter": {
					"match": "any",
					"conditions": [
						{
							"op": "in",
							"column": "id",
							"values": [98, 99]
						}
					]
				}
			},
			"routes": [{ "method": "DELETE", "path": "/rest/v1/customers", "reply": { "json": [] } }],
			"output": [],
			"credential": {
				"host": "https://acme.supabase.co"
			}
		}
	]
}
