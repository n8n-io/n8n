{
	"extends": "@n8n/typescript-config/tsconfig.common.go.json",
	"compilerOptions": {
		"types": ["node"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		// Node's ESM loader reads these files directly when vite loads a config, and wants extensions.
		"allowImportingTsExtensions": true
	},
	"include": ["**/*.ts"]
}
