---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default />
<!-- Inline, so that the first paint has the theme background before the stylesheet loads. -->
<style is:inline>
	:root {
		color-scheme: dark;
		background-color: #1a1a1a;
	}
	:root[data-theme='light'] {
		color-scheme: light;
		background-color: #ffffff;
	}
</style>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://avatars.githubusercontent.com" />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Geist:wght@600;700&family=Inter:wght@400..700&display=swap"
/>

<script>
	// The remark plugin leaves each diagram as <pre class="mermaid"> with its source as text.
	// Render once on load, and again when the reader switches the color theme.
	const MIN_SCALE = 0.75;
	const blocks = Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid'));
	if (blocks.length > 0) {
		const { default: mermaid } = await import('mermaid');
		for (const block of blocks) block.dataset.source = block.textContent ?? '';
		const render = async () => {
			const dark = document.documentElement.dataset.theme === 'dark';
			for (const block of blocks) {
				block.removeAttribute('data-processed');
				block.textContent = block.dataset.source ?? '';
			}
			// The diagrams take their colors from the site tokens of the active theme.
			const css = getComputedStyle(document.documentElement);
			const token = (name: string) => css.getPropertyValue(name).trim();
			const page = token('--sl-color-black');
			const panel = token('--n8n-panel');
			const border = token('--sl-color-gray-5');
			const text = token('--sl-color-white');
			const muted = token('--sl-color-gray-3');
			mermaid.initialize({
				startOnLoad: false,
				theme: 'base',
				darkMode: dark,
				fontFamily: token('--__sl-font'),
				// Tighter than the defaults, so that more diagrams fit the column at full size.
				flowchart: { nodeSpacing: 32, rankSpacing: 40, padding: 12 },
				sequence: { actorMargin: 24, boxMargin: 8, messageMargin: 32, mirrorActors: false },
				themeVariables: {
					fontFamily: token('--__sl-font'),
					fontSize: '14px',
					background: page,
					primaryColor: panel,
					primaryBorderColor: border,
					primaryTextColor: text,
					secondaryColor: panel,
					tertiaryColor: page,
					lineColor: muted,
					textColor: text,
					edgeLabelBackground: page,
					clusterBkg: 'transparent',
					clusterBorder: border,
					actorBkg: panel,
					actorBorder: border,
					actorTextColor: text,
					actorLineColor: border,
					signalColor: muted,
					signalTextColor: text,
					labelBoxBkgColor: panel,
					labelBoxBorderColor: border,
					labelTextColor: text,
					loopTextColor: muted,
					noteBkgColor: token('--sl-color-accent-low'),
					noteBorderColor: token('--sl-color-accent-low'),
					noteTextColor: text,
					activationBkgColor: border,
					activationBorderColor: border,
					sequenceNumberColor: page,
				},
			});
			await mermaid.run({ nodes: blocks });
			// A wide diagram scales down to fit the column, but not below MIN_SCALE. Below that
			// the text gets too small to read, so the diagram scrolls sideways instead.
			for (const block of blocks) {
				const svg = block.querySelector('svg');
				const naturalWidth = svg?.viewBox.baseVal.width;
				if (svg && naturalWidth) svg.style.minWidth = `${Math.round(naturalWidth * MIN_SCALE)}px`;
				// The step circles of a sequence diagram are larger than Mermaid expects, so the last
				// circle would stick out below the drawing. Extra room at the bottom keeps it whole.
				if (svg?.querySelector('.sequenceNumber')) {
					const box = svg.viewBox.baseVal;
					svg.setAttribute('viewBox', `${box.x} ${box.y} ${box.width} ${box.height + 12}`);
				}
				// Mermaid puts the label of a self-message above its loop, halfway to the step before.
				// The label moves to the right of the loop, so it sits next to its own step number.
				// Mermaid draws a self-message as a path, after the text lines of its label.
				const loops = svg?.querySelectorAll<SVGPathElement>('path.messageLine0, path.messageLine1');
				for (const loop of loops ?? []) {
					const lines: SVGTextElement[] = [];
					let label = loop.previousElementSibling;
					while (label instanceof SVGTextElement && label.classList.contains('messageText')) {
						lines.unshift(label);
						label = label.previousElementSibling;
					}
					if (lines.length === 0) continue;
					// Mermaid bends the loop 60px out for a 20px drop, so it looks stretched. Pull it in.
					const points = (loop.getAttribute('d') ?? '').match(/-?[\d.]+/g)?.map(Number) ?? [];
					if (points.length === 8) {
						const [startX, startY] = points;
						const [endX, mermaidEndY] = points.slice(6);
						// The arrow head ends lower, so that it does not touch the step circle.
						const endY = mermaidEndY + 6;
						const reach = 40;
						loop.setAttribute(
							'd',
							`M ${startX},${startY} C ${startX + reach},${startY - 8} ${endX + reach},${endY + 8} ${endX},${endY}`,
						);
					}
					const curve = loop.getBBox();
					const lineHeight = lines[0].getBBox().height;
					const top = curve.y + curve.height / 2 - (lines.length * lineHeight) / 2;
					lines.forEach((line, index) => {
						line.setAttribute('x', `${curve.x + curve.width + 8}`);
						line.setAttribute('y', `${top + index * lineHeight}`);
						line.setAttribute('dy', '0.8em');
						line.setAttribute('text-anchor', 'start');
						line.style.textAnchor = 'start';
					});
				}
				// The step circle of the message above a loop touches the top of the loop box. Only the
				// top of the box moves down. The messages inside the box stay where they are.
				const loopTopShift = 16;
				for (const box of svg?.querySelectorAll('g:has(> line.loopLine)') ?? []) {
					const edges = Array.from(box.querySelectorAll<SVGLineElement>(':scope > line.loopLine'));
					const top = Math.min(...edges.map((edge) => Math.min(edge.y1.baseVal.value, edge.y2.baseVal.value)));
					for (const edge of edges) {
						if (edge.y1.baseVal.value === top) edge.y1.baseVal.value += loopTopShift;
						if (edge.y2.baseVal.value === top) edge.y2.baseVal.value += loopTopShift;
					}
					for (const part of box.querySelectorAll(':scope > .labelBox, :scope > .labelText, :scope > .loopText')) {
						part.setAttribute('transform', `translate(0, ${loopTopShift})`);
					}
				}
				// A label that moved to the right can reach past the drawing, so the drawing widens.
				if (svg && loops && loops.length > 0) {
					const box = svg.viewBox.baseVal;
					const content = svg.getBBox();
					const right = Math.max(box.x + box.width, content.x + content.width + 8);
					svg.setAttribute('viewBox', `${box.x} ${box.y} ${right - box.x} ${box.height}`);
				}
			}
		};
		await render();
		new MutationObserver(render).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});

		// A wide diagram is scaled down to fit the column. A click moves it into an overlay on
		// <body>, where it can use the whole window. The content column uses CSS containment, so a
		// fixed element inside it would stay confined to the column.
		const placeholders = new Map<HTMLElement, HTMLElement>();
		const setZoom = (block: HTMLElement, zoomed: boolean) => {
			const overlay = block.parentElement;
			if (zoomed && !placeholders.has(block)) {
				const placeholder = document.createElement('div');
				block.replaceWith(placeholder);
				placeholders.set(block, placeholder);
				const shell = document.createElement('div');
				shell.className = 'mermaid-zoom';
				shell.addEventListener('click', (event) => {
					if (event.target === shell) setZoom(block, false);
				});
				shell.append(block);
				document.body.append(shell);
			} else if (!zoomed && placeholders.has(block)) {
				placeholders.get(block)?.replaceWith(block);
				placeholders.delete(block);
				overlay?.remove();
			}
			block.classList.toggle('zoomed', zoomed);
			document.body.style.overflow = placeholders.size > 0 ? 'hidden' : '';
		};
		for (const block of blocks) {
			block.title = 'Click to zoom';
			block.addEventListener('click', () => setZoom(block, !block.classList.contains('zoomed')));
		}
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') for (const block of blocks) setZoom(block, false);
		});
	}
</script>

<script>
	// The header shows its bottom line only when the page is not at the top. The line also
	// shows how far the reader is through the page.
	const root = document.documentElement;
	const markScrolled = () => {
		root.toggleAttribute('data-scrolled', window.scrollY > 0);
		const scrollable = root.scrollHeight - window.innerHeight;
		const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
		root.style.setProperty('--n8n-read-progress', String(progress));
	};
	markScrolled();
	window.addEventListener('scroll', markScrolled, { passive: true });
	window.addEventListener('resize', markScrolled, { passive: true });
</script>

<script>
	// Starlight marks the heading at the top of the window in "On this page". The last headings
	// of a page never reach the top, so at the end of the page the last heading gets the mark.
	const tocLinks = () =>
		Array.from(document.querySelectorAll<HTMLAnchorElement>('starlight-toc a[href^="#"], mobile-starlight-toc a[href^="#"]'));
	let pending = false;
	const markAtEnd = () => {
		const root = document.documentElement;
		if (window.scrollY + window.innerHeight < root.scrollHeight - 4) return;
		const links = tocLinks();
		const lastHref = links.at(-1)?.getAttribute('href');
		if (!lastHref) return;
		for (const link of links) {
			if (link.getAttribute('href') === lastHref) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
	};
	window.addEventListener(
		'scroll',
		() => {
			if (pending) return;
			pending = true;
			// Run after the Starlight observer, so that this mark is the last one.
			requestAnimationFrame(() => {
				pending = false;
				markAtEnd();
			});
		},
		{ passive: true },
	);
</script>

<script>
	// A page counts as read when the reader scrolls to its end, or at once when it fits on the
	// screen. A page with a quiz also counts as quiz done when every answer is right. Both lists
	// stay in this browser only, and the page works without them.
	const READ_KEY = 'n8n-backend-docs:read-pages';
	const QUIZ_KEY = 'n8n-backend-docs:quiz-pages';
	const normalize = (path: string) => path.replace(/\/+$/, '') || '/';

	const load = (key: string): Set<string> => {
		try {
			const stored: unknown = JSON.parse(localStorage.getItem(key) ?? '[]');
			return new Set(Array.isArray(stored) ? stored.filter((item) => typeof item === 'string') : []);
		} catch {
			return new Set();
		}
	};

	const read = load(READ_KEY);
	const quizDone = load(QUIZ_KEY);
	const current = normalize(location.pathname);

	// After the name of each read page, the sidebar shows a tick. When the quiz of the page is
	// also done, the tick sits in a filled circle. The mark names its meaning on hover.
	const CHECK = '<svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>';
	const showMarks = () => {
		for (const link of document.querySelectorAll<HTMLAnchorElement>('.sidebar-content a[href]')) {
			const path = normalize(new URL(link.href).pathname);
			const state = quizDone.has(path) ? 'quiz' : read.has(path) ? 'read' : undefined;
			let mark = link.querySelector<HTMLElement>('.page-mark');
			if (!state) {
				mark?.remove();
				continue;
			}
			if (!mark) {
				mark = document.createElement('span');
				mark.setAttribute('role', 'img');
				link.append(mark);
			}
			const label = state === 'quiz' ? 'Page read, quiz done' : 'Page read';
			mark.className = `page-mark page-mark--${state}`;
			mark.innerHTML = state === 'quiz' ? CHECK : '\u2713';
			mark.title = label;
			mark.setAttribute('aria-label', label);
		}
	};

	const mark = (pages: Set<string>, key: string) => {
		// Another tab can save marks after this page loads, so add the stored list first.
		for (const path of load(key)) pages.add(path);
		if (pages.has(current)) return;
		pages.add(current);
		try {
			localStorage.setItem(key, JSON.stringify([...pages]));
		} catch {
			// Storage can be blocked. The mark then shows only until the next page load.
		}
		showMarks();
	};

	const checkEnd = () => {
		const root = document.documentElement;
		if (window.scrollY + window.innerHeight >= root.scrollHeight - 48) mark(read, READ_KEY);
	};

	showMarks();
	checkEnd();
	window.addEventListener('scroll', checkEnd, { passive: true });
	// The quiz is at the end of the page, so a quiz done also counts as a read page.
	document.addEventListener('quiz:all-right', () => {
		mark(read, READ_KEY);
		mark(quizDone, QUIZ_KEY);
	});
</script>

<script>
	// The remark plugin marks each quiz question with its right letter. Each option becomes a
	// button. The first choice locks the question, marks the right and the wrong option, and
	// shows the explanation with a "Clear" button that resets the question. Nothing is saved.
	for (const question of document.querySelectorAll<HTMLElement>('.quiz-question')) {
		const options = Array.from(question.querySelectorAll<HTMLElement>('.quiz-options > li'));
		const explanation = question.querySelector<HTMLElement>('.quiz-explanation');
		const buttons = options.map((option) => {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'quiz-option';
			const letter = document.createElement('span');
			letter.className = 'quiz-letter';
			letter.textContent = option.dataset.letter ?? '';
			button.append(letter, ...option.childNodes);
			option.append(button);
			return button;
		});
		// The verdict and the retry button share the first line of the feedback panel.
		const head = document.createElement('div');
		head.className = 'quiz-feedback-head';
		const verdict = document.createElement('span');
		verdict.className = 'quiz-verdict';
		const retry = document.createElement('button');
		retry.type = 'button';
		retry.className = 'quiz-retry';
		retry.innerHTML =
			'<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M2.75 8a5.25 5.25 0 1 0 1.6-3.77M2.75 2.75v2.5h2.5" /></svg>Clear';
		head.append(verdict, retry);
		explanation?.prepend(head);

		const reset = () => {
			for (const button of buttons) {
				button.disabled = false;
				button.removeAttribute('data-result');
			}
			if (explanation) explanation.hidden = true;
			delete question.dataset.result;
		};
		buttons.forEach((button, index) => {
			button.addEventListener('click', () => {
				const right = options[index].dataset.letter === question.dataset.answer;
				buttons.forEach((other, i) => {
					other.disabled = true;
					if (options[i].dataset.letter === question.dataset.answer) other.dataset.result = 'right';
				});
				if (!right) button.dataset.result = 'wrong';
				question.dataset.result = right ? 'right' : 'wrong';
				verdict.textContent = right ? 'Correct' : `Wrong, the answer is ${question.dataset.answer}`;
				if (explanation) explanation.hidden = false;
				const questions = document.querySelectorAll<HTMLElement>('.quiz-question');
				if (Array.from(questions).every((item) => item.dataset.result === 'right')) {
					document.dispatchEvent(new Event('quiz:all-right'));
				}
			});
		});
		retry.addEventListener('click', reset);
	}
</script>

<script>
	// CI deploys each PR to pr-<number>.n8n-backend-docs.pages.dev. On those hosts, a corner
	// label shows that the page is a preview and links to the PR.
	const pr = /^pr-(\d+)\./.exec(location.hostname)?.[1];
	if (pr) {
		const label = document.createElement('a');
		label.className = 'preview-label';
		label.href = `https://github.com/n8n-io/n8n/pull/${pr}`;
		label.textContent = `Preview of PR #${pr}`;
		document.body.append(label);
	}
</script>
