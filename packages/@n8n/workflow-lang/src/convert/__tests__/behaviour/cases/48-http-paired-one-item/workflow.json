{
	"name": "HTTP paired read with one item",
	"nodes": [
		{
			"id": "webhook",
			"name": "Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [
				0,
				0
			],
			"parameters": {
				"httpMethod": "POST",
				"path": "http-paired-one",
				"options": {}
			},
			"webhookId": "9d1a6f42-2c3b-4e5d-8a7f-1b2c3d4e5f64"
		},
		{
			"id": "source",
			"name": "Source",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				200,
				0
			],
			"parameters": {
				"jsCode": "return [{ json: { n: 10 } }];"
			}
		},
		{
			"id": "http",
			"name": "Http",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [
				400,
				0
			],
			"parameters": {
				"method": "GET",
				"url": "http://127.0.0.1:47123/thing/{{ $json.n }}",
				"authentication": "none",
				"options": {
					"response": {
						"response": {
							"responseFormat": "json"
						}
					}
				}
			}
		},
		{
			"id": "read-each",
			"name": "Read Each",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				600,
				0
			],
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "return { json: { got: $json.got, src: $('Source').item.json.n } };"
			}
		},
		{
			"id": "read-expr",
			"name": "Read Expr",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				600,
				100
			],
			"parameters": {
				"mode": "raw",
				"jsonOutput": "={ \"got\": \"{{ $json.got }}\", \"src\": {{ $('Source').item.json.n }} }",
				"options": {}
			}
		}
	],
	"connections": {
		"Webhook": {
			"main": [
				[
					{
						"node": "Source",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Source": {
			"main": [
				[
					{
						"node": "Http",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Http": {
			"main": [
				[
					{
						"node": "Read Each",
						"type": "main",
						"index": 0
					},
					{
						"node": "Read Expr",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
