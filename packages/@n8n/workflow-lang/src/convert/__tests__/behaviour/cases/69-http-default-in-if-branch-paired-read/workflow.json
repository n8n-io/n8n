{
	"name": "HTTP default format in an If branch",
	"nodes": [
		{
			"id": "webhook",
			"name": "Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [
				0,
				0
			],
			"parameters": {
				"httpMethod": "POST",
				"path": "http-default-if-branch",
				"options": {}
			},
			"webhookId": "0b7f1c2e-3d4a-4b5c-8d6e-000000000069"
		},
		{
			"id": "source",
			"name": "Source",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				200,
				0
			],
			"parameters": {
				"jsCode": "return [{ json: { id: 'a0', pass: true } }, { json: { id: 'a1', pass: false } }, { json: { id: 'a2', pass: true } }, { json: { id: 'a3', pass: true } }];"
			}
		},
		{
			"id": "split",
			"name": "Split",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2,
			"position": [
				300,
				0
			],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "c1",
							"leftValue": "={{ $json.pass }}",
							"operator": {
								"type": "boolean",
								"operation": "equals"
							},
							"rightValue": true
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "http",
			"name": "Http",
			"type": "n8n-nodes-base.httpRequest",
			"position": [
				400,
				0
			],
			"typeVersion": 4.2,
			"parameters": {
				"method": "GET",
				"url": "=http://127.0.0.1:47123/thing/{{ $json.id }}",
				"authentication": "none",
				"options": {}
			}
		},
		{
			"id": "read-each",
			"name": "Read Each",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				600,
				0
			],
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "return { json: { got: $json.got ?? null, src: $('Source').item.json.id } };"
			}
		},
		{
			"id": "read-all",
			"name": "Read All",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				600,
				100
			],
			"parameters": {
				"jsCode": "return items.map((item, k) => ({ json: { got: item.json.got ?? null, src: $('Source').itemMatching(k).json.id } }));"
			}
		},
		{
			"id": "read-expr",
			"name": "Read Expr",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				600,
				200
			],
			"parameters": {
				"mode": "raw",
				"jsonOutput": "={ \"src\": \"{{ $('Source').item.json.id }}\" }",
				"options": {}
			}
		}
	],
	"connections": {
		"Webhook": {
			"main": [
				[
					{
						"node": "Source",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Source": {
			"main": [
				[
					{
						"node": "Split",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Http": {
			"main": [
				[
					{
						"node": "Read Each",
						"type": "main",
						"index": 0
					},
					{
						"node": "Read All",
						"type": "main",
						"index": 0
					},
					{
						"node": "Read Expr",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Split": {
			"main": [
				[
					{
						"node": "Http",
						"type": "main",
						"index": 0
					}
				],
				[]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
