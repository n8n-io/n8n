{
	"name": "HTTP default format generic credential",
	"nodes": [
		{
			"id": "webhook",
			"name": "Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [
				0,
				0
			],
			"parameters": {
				"httpMethod": "POST",
				"path": "http-default-generic",
				"options": {}
			},
			"webhookId": "0b7f1c2e-3d4a-4b5c-8d6e-ault-generic"
		},
		{
			"id": "source",
			"name": "Source",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				200,
				0
			],
			"parameters": {
				"jsCode": "return [{ json: { id: 'a0' } }, { json: { id: 'a1' } }, { json: { id: 'a2' } }];"
			}
		},
		{
			"id": "http",
			"name": "Http",
			"type": "n8n-nodes-base.httpRequest",
			"position": [
				400,
				0
			],
			"typeVersion": 4.4,
			"parameters": {
				"method": "GET",
				"url": "=http://127.0.0.1:47123/thing/{{ $json.id }}",
				"authentication": "genericCredentialType",
				"genericAuthType": "httpHeaderAuth",
				"options": {}
			},
			"credentials": {
				"httpHeaderAuth": {
					"id": "1",
					"name": "Header"
				}
			}
		},
		{
			"id": "read-each",
			"name": "Read Each",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				600,
				0
			],
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "return { json: { got: $json.got ?? null, src: $('Source').item.json.id } };"
			}
		},
		{
			"id": "read-all",
			"name": "Read All",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				600,
				100
			],
			"parameters": {
				"jsCode": "return items.map((item, k) => ({ json: { got: item.json.got ?? null, src: $('Source').itemMatching(k).json.id } }));"
			}
		},
		{
			"id": "read-expr",
			"name": "Read Expr",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				600,
				200
			],
			"parameters": {
				"mode": "raw",
				"jsonOutput": "={ \"src\": \"{{ $('Source').item.json.id }}\" }",
				"options": {}
			}
		}
	],
	"connections": {
		"Webhook": {
			"main": [
				[
					{
						"node": "Source",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Source": {
			"main": [
				[
					{
						"node": "Http",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Http": {
			"main": [
				[
					{
						"node": "Read Each",
						"type": "main",
						"index": 0
					},
					{
						"node": "Read All",
						"type": "main",
						"index": 0
					},
					{
						"node": "Read Expr",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
