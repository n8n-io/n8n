{
	"name": "Retry, RSS Feed Read",
	"nodes": [
		{
			"id": "webhook",
			"name": "Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [
				0,
				0
			],
			"parameters": {
				"httpMethod": "POST",
				"path": "retry-92",
				"options": {}
			},
			"webhookId": "0b7f1c2e-3d4a-4b5c-8d6e-000000000092"
		},
		{
			"id": "source",
			"name": "Source",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				200,
				0
			],
			"parameters": {
				"jsCode": "return [{ json: { id: 'a0' } }, { json: { id: 'a1' } }, { json: { id: 'a2' } }];"
			}
		},
		{
			"id": "feed",
			"name": "Feed",
			"type": "n8n-nodes-base.rssFeedRead",
			"typeVersion": 1.2,
			"position": [
				400,
				0
			],
			"retryOnFail": true,
			"maxTries": 2,
			"waitBetweenTries": 1,
			"parameters": {
				"url": "=http://127.0.0.1:47123/feed/{{ $json.id }}",
				"options": {}
			}
		},
		{
			"id": "end",
			"name": "End",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [
				600,
				0
			],
			"parameters": {
				"mode": "raw",
				"jsonOutput": "={ \"title\": \"{{ $json.title }}\" }",
				"options": {}
			}
		}
	],
	"connections": {
		"Webhook": {
			"main": [
				[
					{
						"node": "Source",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Source": {
			"main": [
				[
					{
						"node": "Feed",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Feed": {
			"main": [
				[
					{
						"node": "End",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
