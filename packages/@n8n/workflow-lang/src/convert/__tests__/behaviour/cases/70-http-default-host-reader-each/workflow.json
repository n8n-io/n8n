{
	"name": "HTTP default format host reader, each item",
	"nodes": [
		{
			"id": "webhook",
			"name": "Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [
				0,
				0
			],
			"parameters": {
				"httpMethod": "POST",
				"path": "http-default-host-each",
				"options": {}
			},
			"webhookId": "0b7f1c2e-3d4a-4b5c-8d6e-000000000070"
		},
		{
			"id": "source",
			"name": "Source",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				200,
				0
			],
			"parameters": {
				"jsCode": "return [{ json: { id: 'a0' } }, { json: { id: 'a1' } }, { json: { id: 'a2' } }];"
			}
		},
		{
			"id": "http",
			"name": "Http",
			"type": "n8n-nodes-base.httpRequest",
			"position": [
				400,
				0
			],
			"typeVersion": 4.2,
			"parameters": {
				"method": "GET",
				"url": "=http://127.0.0.1:47123/thing/{{ $json.id }}",
				"authentication": "none",
				"options": {}
			}
		},
		{
			"id": "read-each",
			"name": "Read Each",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				600,
				0
			],
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "class Box { constructor(v) { this.v = v; } get() { return this.v; } }\nreturn { json: { got: $json.got ?? null, src: new Box($('Source').item.json.id).get() } };"
			}
		}
	],
	"connections": {
		"Webhook": {
			"main": [
				[
					{
						"node": "Source",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Source": {
			"main": [
				[
					{
						"node": "Http",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Http": {
			"main": [
				[
					{
						"node": "Read Each",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
