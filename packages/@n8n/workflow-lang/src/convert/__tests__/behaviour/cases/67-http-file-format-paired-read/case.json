{
	"description": "An HTTP Request with the response format 'file': the runtime stores the first and the third response, and cannot store the second, so the fallback host runs the v1 node for that item. The readers get the item of Source of each output item",
	"trigger": {
		"body": {}
	},
	"http": {
		"Http": {
			"path": "thing",
			"responses": [
				{
					"url": "/thing/a0",
					"status": 200,
					"body": "first-file",
					"headers": {
						"content-type": "text/plain"
					}
				},
				{
					"url": "/thing/a1",
					"status": 200,
					"body": "not-a-real-image",
					"headers": {
						"content-type": "image/png"
					},
					"runtimeLimit": true
				},
				{
					"url": "/thing/a2",
					"status": 200,
					"body": "third-file",
					"headers": {
						"content-type": "text/plain"
					}
				}
			]
		}
	},
	"compare": [
		"Read Each",
		"Read All",
		"Read Expr"
	],
	"storesResponses": true
}
