		{
			"id": "choose",
			"name": "Choose",
			"type": "n8n-nodes-base.merge",
			"typeVersion": 3.1,
			"position": [1000, 0],
			"parameters": {
				"mode": "chooseBranch",
				"useDataOfInput": 1
			}
		}
