		{
			"id": "route",
			"name": "Route",
			"type": "n8n-nodes-base.switch",
			"typeVersion": 2,
			"position": [400, 0],
			"parameters": {
				"dataType": "string",
				"value1": "={{ $json.kind }}",
				"rules": {
					"rules": [
						{
							"value2": "a"
						},
						{
							"operation": "startsWith",
