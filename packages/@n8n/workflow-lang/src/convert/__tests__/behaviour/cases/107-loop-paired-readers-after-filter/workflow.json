						"version": 2
					},
					"conditions": [
						{
							"id": "c1",
							"leftValue": "={{ $json.id }}",
							"operator": {
								"type": "string",
								"operation": "notEquals"
							},
							"rightValue": "a1"
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "read-each",
			"name": "Read Each",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [800, -100],
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "return { json: { from: $('A').item.json.id } };"
			}
		},
		{
			"id": "read-all",
			"name": "Read All",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [800, 0],
			"parameters": {
				"jsCode": "return [{ json: { from: $('A').item.json.id } }];"
			}
		},
		{
			"id": "read-expr",
			"name": "Read Expr",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [800, 100],
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "rx-f",
							"name": "from",
							"value": "={{ $('A').item.json.id }}",
							"type": "string"
						}
					]
				},
				"options": {}
			}
		}
	],
	"connections": {
