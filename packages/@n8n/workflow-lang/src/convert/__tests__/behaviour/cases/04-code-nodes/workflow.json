{
	"name": "Code steps",
	"nodes": [
		{
			"id": "webhook",
			"name": "Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [0, 0],
			"parameters": {
				"httpMethod": "POST",
				"path": "numbers",
				"responseMode": "responseNode",
				"options": {}
			}
		},
		{
			"id": "prepare",
			"name": "Prepare",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [200, 0],
			"parameters": {
				"jsCode": "const out = [];\nfor (const item of $input.all()) {\n  for (const n of item.json.body.numbers) out.push({ json: { n } });\n}\nreturn out;"
			}
		},
		{
			"id": "double",
			"name": "Double",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [400, 0],
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "return { json: { n: $json.n, double: $json.n * 2, index: $itemIndex } };"
			}
		},
		{
			"id": "sum",
			"name": "Sum",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [600, 0],
			"parameters": {
				"jsCode": "const items = $input.all();\nconst total = items.reduce((s, i) => s + i.json.double, 0);\nreturn [{ json: { total, label: $('Webhook').first().json.body.label } }];"
			}
		},
		{
			"id": "respond",
			"name": "Respond",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.1,
			"position": [800, 0],
			"parameters": {
				"respondWith": "allIncomingItems",
				"options": {}
			}
		}
	],
	"connections": {
		"Webhook": {
			"main": [
				[
					{
						"node": "Prepare",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Prepare": {
			"main": [
				[
					{
						"node": "Double",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Double": {
			"main": [
				[
					{
						"node": "Sum",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Sum": {
			"main": [
				[
					{
						"node": "Respond",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	}
}
