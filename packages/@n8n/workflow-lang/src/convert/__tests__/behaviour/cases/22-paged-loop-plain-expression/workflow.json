{
	"name": "Paged loop",
	"nodes": [
		{
			"id": "webhook",
			"name": "Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [0, 0],
			"parameters": {
				"httpMethod": "POST",
				"path": "paged",
				"options": {}
			}
		},
		{
			"id": "search",
			"name": "Search",
			"type": "n8n-nodes-base.httpRequest",
			"typeVersion": 4.2,
			"position": [200, 0],
			"parameters": {
				"method": "POST",
				"url": "http://127.0.0.1:47123/search",
				"sendBody": true,
				"specifyBody": "=json",
				"bodyParameters": {
					"parameters": [{}]
				},
				"jsonBody": "={{ JSON.stringify({ query: 'x', after: $json.after ?? '' }) }}",
				"options": {}
			}
		},
		{
			"id": "next",
			"name": "Next Page",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [400, 0],
			"parameters": {
				"jsCode": "const response = $('Search').first().json;\nreturn [{ json: { hasNextPage: response.paging?.next?.after !== undefined, after: response.paging?.next?.after || null } }];"
			}
		},
		{
			"id": "if",
			"name": "Has Next Page",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [600, 0],
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "strict",
						"version": 2
					},
					"conditions": [
						{
							"id": "c1",
							"leftValue": "={{ $json.hasNextPage }}",
							"rightValue": false,
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			}
		},
		{
			"id": "done",
			"name": "Done",
			"type": "n8n-nodes-base.noOp",
			"typeVersion": 1,
			"position": [800, 100],
			"parameters": {}
		}
	],
	"connections": {
		"Webhook": {
			"main": [
				[
					{
						"node": "Search",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Search": {
			"main": [
				[
					{
						"node": "Next Page",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Next Page": {
			"main": [
				[
					{
						"node": "Has Next Page",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Has Next Page": {
			"main": [
				[
					{
						"node": "Search",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Done",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	}
}
