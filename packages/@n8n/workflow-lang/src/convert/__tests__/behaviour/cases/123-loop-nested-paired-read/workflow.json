			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [900, 1100],
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "rx-f",
							"name": "from",
							"value": "={{ $('Make').item.json.id }}",
							"type": "string"
						}
					]
				},
				"options": {}
			}
		}
	],
