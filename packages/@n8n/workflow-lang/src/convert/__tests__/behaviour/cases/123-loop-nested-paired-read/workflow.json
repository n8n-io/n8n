			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [1000, 100],
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "tag-f",
							"name": "tag",
							"value": "={{ $json.id }}-tag",
							"type": "string"
						}
					]
				},
				"includeOtherFields": true,
				"options": {}
			}
		},
		{
			"id": "read-each",
			"name": "Read Each",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [900, 900],
			"parameters": {
				"mode": "runOnceForEachItem",
				"jsCode": "return { json: { from: $('Make').item.json.id } };"
			}
		},
		{
			"id": "read-all",
			"name": "Read All",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [900, 1000],
			"parameters": {
				"jsCode": "return [{ json: { from: $('Make').item.json.id } }];"
			}
		},
		{
			"id": "read-expr",
