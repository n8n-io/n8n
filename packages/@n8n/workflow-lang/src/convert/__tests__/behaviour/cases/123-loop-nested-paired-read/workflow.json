			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [700, 100],
			"parameters": {
				"jsCode": "const id = $input.first().json.id;\nreturn [0, 1, 2].map((k) => ({ json: { id: `${id}-${k}` } }));"
			}
		},
		{
			"id": "inner",
			"name": "Inner",
			"type": "n8n-nodes-base.splitInBatches",
