{
  "name": "@n8n/n8n-node-codegen",
  "version": "0.1.0",
  "private": true,
  "description": "Generates version 2 of the n8n node from the public API spec",
  "scripts": {
    "clean": "rimraf .turbo",
    "build": "tsx src/index.ts && pnpm --filter n8n-nodes-base build",
    "generate": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:dev": "vitest",
    "format": "biome format --write .",
    "format:check": "biome ci ."
  },
  "devDependencies": {
    "@redocly/openapi-core": "1.34.21",
    "@n8n/vitest-config": "workspace:*",
    "n8n-nodes-base": "workspace:*",
    "n8n-workflow": "workspace:*",
    "openapi-types": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
