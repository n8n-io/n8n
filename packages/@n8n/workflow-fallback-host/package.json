{
  "name": "@n8n/workflow-fallback-host",
  "version": "0.1.0",
  "private": true,
  "description": "Runs the steps that the compiled workflow runtime cannot run natively (proof of concept)",
  "scripts": {
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck",
    "start": "node dist/main.js",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:dev": "vitest --silent=false"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "wf-fallback-host": "dist/main.js"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "@n8n/engine": "workspace:*",
    "@n8n/n8n-nodes-langchain": "workspace:*",
    "@n8n/node-engine-compatibility": "workspace:*",
    "n8n-core": "workspace:*",
    "n8n-nodes-base": "workspace:*",
    "n8n-workflow": "workspace:*"
  },
  "devDependencies": {
    "@n8n/oxlint-config": "workspace:*",
    "@n8n/typescript-config": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:typescript",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
