{
	"kind": "action",
	"id": "httpRequest.get",
	"semver": "2.0.0",
	"nodeContract": "2.1.0",
	"sdk": "0.1.0",
	"contractHash": "f42a44ade732564d61cea8a3b93d6add847720839221e2207b37f6762bb8b470",
	"bundleHash": "719736b31b4969e2a174f913e5d212c9c768f73984ac897d39ccc1894d9547a5",
	"contract": {
		"id": "httpRequest.get",
		"version": 2,
		"node": "httpRequest",
		"nodeDisplayName": "HTTP Request",
		"action": "GET a URL",
		"summary": "Read from any HTTP API. Use a dedicated action when one exists for the service.",
		"flow": {
			"effect": "read",
			"cardinality": "1:N",
			"idempotent": true,
			"passthrough": "replace"
		},
		"credentials": [
			"httpHeaderAuth",
			"httpBearerAuth",
			"httpBasicAuth",
			"httpQueryAuth",
			"oAuth2Api"
		],
		"credentialOptional": true,
		"input": {
			"type": "object",
			"properties": {
				"url": {
					"type": "string",
					"x-n8n-hint": "Full URL; never URL-encode an expression"
				},
				"query": {
					"type": "object",
					"additionalProperties": {
						"type": "string"
					},
					"x-n8n-hint": "Never put secrets here; attach a credential"
				},
				"headers": {
					"type": "object",
					"additionalProperties": {
						"type": "string"
					},
					"x-n8n-hint": "Never put secrets here; attach a credential"
				},
				"pagination": {
					"type": "object",
					"properties": {
						"cursorPath": {
							"type": "string",
							"x-n8n-hint": "Dot path to the next cursor in the response body, e.g. next_cursor"
						},
						"queryParameter": {
							"type": "string",
							"x-n8n-hint": "Query parameter that sends the cursor, e.g. cursor"
						},
						"maxPages": {
							"type": "integer",
							"minimum": 1,
							"default": 100
						}
					},
					"required": [
						"cursorPath",
						"queryParameter"
					],
					"additionalProperties": false,
					"x-n8n-hint": "Cursor pagination; each page emits items; stops on a null or empty cursor"
				}
			},
			"required": [
				"url"
			],
			"additionalProperties": false
		},
		"output": {
			"type": "object",
			"additionalProperties": true,
			"x-n8n-hint": "The parsed response body; an array body emits one item per element"
		},
		"egress": {
			"fromInput": "url"
		}
	}
}
