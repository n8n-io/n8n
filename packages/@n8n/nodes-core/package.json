{
  "name": "@n8n/nodes-core",
  "version": "0.1.0",
  "private": true,
  "description": "n8n core nodes defined as node contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "clean": "rimraf dist .turbo",
    "dev": "pnpm watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && pnpm freeze",
    "build:unchecked": "tsc -p tsconfig.build.json --noCheck && pnpm freeze",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "freeze": "tsx scripts/freeze.ts",
    "publish:contracts": "tsx scripts/publish.ts",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@n8n/node-sdk": "workspace:*"
  },
  "devDependencies": {
    "@n8n/eslint-config": "workspace:*",
    "@n8n/typescript-config": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "tsx": "catalog:",
    "typescript": "catalog:typescript",
    "vitest": "catalog:"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
