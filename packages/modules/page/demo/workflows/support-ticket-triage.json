			"name": "Score urgency",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [880, 200],
			"parameters": {
				"jsCode": "const ticket = $('New ticket webhook').first().json.body;\nconst urgentWords = ['refund', 'broken', 'urgent', 'charged twice'];\nconst text = ticket.message.toLowerCase();\nconst hits = urgentWords.filter((word) => text.includes(word)).length;\nconst isVip = $('Look up customer').first().json.lifetimeValue > 5000;\nconst urgency = hits >= 2 || (hits >= 1 && isVip) ? 'high' : hits === 1 ? 'medium' : 'low';\nreturn [{ json: { ...ticket, urgency, isVip, orders: $input.all().map((item) => item.json) } }];"
			}
		},
