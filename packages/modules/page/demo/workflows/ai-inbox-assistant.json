{
	"id": "4S3UYna80HnT5pWA",
	"name": "AI inbox assistant",
	"nodes": [
		{
			"id": "dddddddd-0000-4000-8000-000000000001",
			"name": "New email in support inbox",
			"type": "n8n-nodes-base.gmailTrigger",
			"typeVersion": 1.2,
			"position": [0, 300],
			"parameters": {
				"pollTimes": {
					"item": [
						{
							"mode": "everyMinute"
						}
					]
				},
				"filters": {
					"labelIds": ["INBOX"]
				},
				"simple": true
			}
		},
		{
			"id": "dddddddd-0000-4000-8000-000000000002",
			"name": "Classify and draft reply",
			"type": "@n8n/n8n-nodes-langchain.agent",
			"typeVersion": 1.7,
			"position": [240, 300],
			"parameters": {
				"promptType": "define",
				"text": "=Subject: {{ $json.subject }}\n\n{{ $json.snippet }}",
				"options": {
					"systemMessage": "You triage support email. Answer with JSON only: {\"category\": \"billing\" | \"bug\" | \"sales\" | \"spam\", \"draft\": \"<a short polite reply>\"}. Never promise a refund."
				}
			}
		},
		{
			"id": "dddddddd-0000-4000-8000-000000000003",
			"name": "Claude model",
			"type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
			"typeVersion": 1.3,
			"position": [240, 520],
			"parameters": {
				"model": {
					"__rl": true,
					"mode": "list",
					"value": "claude-sonnet-5-5"
				},
				"options": {
					"temperature": 0.2
				}
			}
		},
		{
			"id": "dddddddd-0000-4000-8000-000000000004",
			"name": "Parse answer",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [520, 300],
			"parameters": {
				"jsCode": "const answer = JSON.parse($input.first().json.output);\nconst email = $('New email in support inbox').first().json;\nreturn [{ json: { ...email, ...answer } }];"
			},
			"onError": "continueErrorOutput"
		},
		{
			"id": "dddddddd-0000-4000-8000-000000000005",
			"name": "Route by category",
			"type": "n8n-nodes-base.switch",
			"typeVersion": 3.2,
			"position": [740, 300],
			"parameters": {
				"rules": {
					"values": [
						{
							"outputKey": "billing",
							"renameOutput": true,
							"conditions": {
								"options": {
									"caseSensitive": true,
									"leftValue": "",
									"typeValidation": "strict",
									"version": 2
								},
								"conditions": [
									{
										"leftValue": "={{ $json.category }}",
										"rightValue": "billing",
										"operator": {
											"type": "string",
											"operation": "equals"
										}
									}
								],
								"combinator": "and"
							}
						},
						{
							"outputKey": "bug",
							"renameOutput": true,
							"conditions": {
								"options": {
									"caseSensitive": true,
									"leftValue": "",
									"typeValidation": "strict",
									"version": 2
								},
								"conditions": [
									{
										"leftValue": "={{ $json.category }}",
										"rightValue": "bug",
										"operator": {
											"type": "string",
											"operation": "equals"
										}
									}
								],
								"combinator": "and"
							}
						},
						{
							"outputKey": "sales",
							"renameOutput": true,
							"conditions": {
								"options": {
									"caseSensitive": true,
									"leftValue": "",
									"typeValidation": "strict",
									"version": 2
								},
								"conditions": [
									{
										"leftValue": "={{ $json.category }}",
										"rightValue": "sales",
										"operator": {
											"type": "string",
											"operation": "equals"
										}
									}
								],
								"combinator": "and"
							}
						}
					]
				},
				"options": {
					"fallbackOutput": "extra",
					"renameFallbackOutput": "other"
				}
			}
		},
