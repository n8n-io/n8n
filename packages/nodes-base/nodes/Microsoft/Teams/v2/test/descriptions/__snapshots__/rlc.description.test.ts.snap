    "displayName": "User",
    "modes": [
      {
        "displayName": "From List",
        "name": "list",
        "placeholder": "Select a User...",
        "type": "list",
        "typeOptions": {
          "searchListMethod": "getUsers",
          "searchable": true,
        },
      },
      {
        "displayName": "By ID",
        "name": "id",
        "placeholder": "e.g. jacob@contoso.com",
        "type": "string",
        "validation": [
          {
            "properties": {
