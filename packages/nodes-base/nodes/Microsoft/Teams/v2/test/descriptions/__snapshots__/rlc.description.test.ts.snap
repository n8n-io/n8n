      "value": "",
    },
    "description": "The online meeting, by its ID or by its join URL",
    "displayName": "Meeting",
    "modes": [
      {
        "displayName": "By ID",
        "hint": "The ID returned when the meeting was created, not the numeric meeting ID from the invite",
        "name": "id",
        "placeholder": "e.g. MSpkYzE3Njc0Yy04MWQ5LTRhZGItYmZi...",
