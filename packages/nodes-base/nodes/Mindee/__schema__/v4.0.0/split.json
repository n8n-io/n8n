{
	"type": "object",
	"properties": {
		"inference": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"description": "ID of the inference"
				},
				"job": {
					"type": "object",
					"description": "Job the inference belongs to",
					"properties": {
						"id": {
							"type": "string",
							"description": "UUID of the Job"
						}
					}
				},
				"model": {
					"type": "object",
					"description": "Model info for the inference",
					"properties": {
						"id": {
							"type": "string",
							"description": "ID of the model"
						}
					}
				},
				"file": {
					"type": "object",
					"description": "File info for the inference",
					"properties": {
						"name": {
							"type": "string",
							"description": "Name of the file"
						},
						"alias": {
							"type": "string",
							"description": "Optional alias for the file"
						},
						"page_count": {
							"type": "integer",
							"description": "Page count"
						},
						"mime_type": {
							"type": "string",
							"description": "MIME type"
						}
					}
				},
				"result": {
					"type": "object",
					"description": "Result of a split inference",
					"properties": {
						"splits": {
							"type": "array",
							"description": "List of split ranges",
							"items": {
								"type": "object",
								"properties": {
									"page_range": {
										"type": "array",
										"description": "0-based page indexes, where the first integer indicates the start page and the second integer indicates the end page",
										"items": {
											"type": "integer"
										}
									},
									"document_type": {
										"type": "string",
										"description": "The document type, as identified on given classification values"
									},
									"extraction_response": {
										"type": "object",
										"description": "The extraction response associated with the split"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
