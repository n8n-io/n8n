			"typeVersion": 1,
			"position": [520, -140]
		},
		{
			"parameters": {
				"basePath": "orders-app",
				"endpoints": {
					"endpoint": [
						{
							"method": "GET",
							"path": "/"
						},
						{
							"method": "GET",
							"path": "/orders",
							"options": {
								"name": "List orders"
							}
						},
						{
							"method": "POST",
							"path": "/orders",
							"options": {
								"name": "Create order",
								"requestSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"name\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"pattern\": \"\\\\S\"\n    },\n    \"qty\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"name\"\n  ]\n}"
							}
						}
					]
				},
				"options": {
					"validateRequests": true,
					"responseData": "allEntries"
				}
			},
