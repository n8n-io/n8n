    {
      "parameters": {
        "httpMethod": "POST",
        "path": "loadOrders",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "6a1f0a10-0000-4000-8000-000000000011",
      "name": "Webhook loadOrders",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "webhookId": "6a1f0a10-0000-4000-8000-000000000011"
    },
    {
      "parameters": {
        "jsCode": "// The app posts its whole state; the reply is an envelope whose `state` is a\n// partial that gets deep-merged.\nconst store = $getWorkflowStaticData('global');\nstore.orders = store.orders ?? [\n  { name: 'Widget', qty: 3 },\n  { name: 'Sprocket', qty: 1 },\n];\n\nreturn [{ json: { ok: true, state: { orders: store.orders, form: { name: '' } } } }];"
      },
      "id": "6a1f0a10-0000-4000-8000-000000000012",
      "name": "Load",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        240
      ]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "6a1f0a10-0000-4000-8000-000000000013",
      "name": "Respond load",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        240
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "saveOrder",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "6a1f0a10-0000-4000-8000-000000000014",
      "name": "Webhook saveOrder",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        480
      ],
      "webhookId": "6a1f0a10-0000-4000-8000-000000000014"
    },
    {
      "parameters": {
        "jsCode": "// The Webhook node does not pass the posted body straight through: its output is\n// { headers, params, query, body }, so the app's whole state is at $json.body\n// and the typed name is at body.form.name.\nconst store = $getWorkflowStaticData('global');\nstore.orders = store.orders ?? [\n  { name: 'Widget', qty: 3 },\n  { name: 'Sprocket', qty: 1 },\n];\n\nconst state = $json.body ?? {};\nconst name = (state.form?.name ?? '').trim();\n\n// The failure path. `ok: false` raises a toast from the error message, and the\n// state partial still comes back, so rejecting an action and correcting the\n// client's view are not exclusive.\nif (!name) {\n  return [{ json: {\n    ok: false,\n    error: { code: 'VALIDATION_ERROR', message: 'Enter an order name' },\n    state: { orders: store.orders },\n  } }];\n}\n\nstore.orders.push({ name, qty: 1 });\n\n// Clearing form.name is what makes the input empty again after a save. No\n// toast: the button's own action chain says \"Order added\" after this returns,\n// which is the client's job now that an action can do more than one thing.\nreturn [{ json: {\n  ok: true,\n  state: { orders: store.orders, form: { name: '' } },\n} }];"
      },
      "id": "6a1f0a10-0000-4000-8000-000000000015",
      "name": "Save",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        480
      ]
    },
    {
