      ],
      "webhookId": "6a1f0a10-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "title": "Orders",
        "definition": "{\n  \"id\": \"shell-1\",\n  \"type\": \"shell\",\n  \"props\": {\n    \"defaultPage\": \"/\"\n  },\n  \"tree\": {\n    \"header\": [\n      {\n        \"id\": \"stack-nav\",\n        \"type\": \"stack\",\n        \"props\": {\n          \"direction\": \"horizontal\",\n          \"gap\": 12\n        },\n        \"tree\": {\n          \"default\": [\n            {\n              \"id\": \"heading-app\",\n              \"type\": \"heading\",\n              \"props\": {\n                \"text\": \"Orders\",\n                \"level\": 3\n              },\n              \"tree\": {}\n            },\n            {\n              \"id\": \"repeat-nav\",\n              \"type\": \"repeat\",\n              \"props\": {\n                \"items\": \"={{ $pages }}\",\n                \"direction\": \"horizontal\",\n                \"gap\": 8\n              },\n              \"tree\": {\n                \"default\": [\n                  {\n                    \"id\": \"button-nav\",\n                    \"type\": \"button\",\n                    \"props\": {\n                      \"label\": \"={{ $item.title }}\",\n                      \"variant\": \"tertiary\",\n                      \"onClick\": [\n                        {\n                          \"kind\": \"navigate\",\n                          \"to\": \"={{ $item.path }}\"\n                        }\n                      ]\n                    },\n                    \"tree\": {}\n                  }\n                ]\n              }\n            }\n          ]\n        }\n      }\n    ],\n    \"default\": [\n      {\n        \"id\": \"page-orders\",\n        \"type\": \"page\",\n        \"props\": {\n          \"path\": \"/\",\n          \"title\": \"Orders\",\n          \"onEnter\": [\n            {\n              \"kind\": \"webhook\",\n              \"url\": \"http://localhost:5678/webhook/loadOrders\",\n              \"method\": \"POST\"\n            }\n          ]\n        },\n        \"tree\": {\n          \"default\": [\n            {\n              \"id\": \"heading-orders\",\n              \"type\": \"heading\",\n              \"props\": {\n                \"text\": \"Orders\",\n                \"level\": 2\n              },\n              \"tree\": {}\n            },\n            {\n              \"id\": \"table-1\",\n              \"type\": \"table\",\n              \"props\": {\n                \"rows\": \"={{ $state.orders }}\",\n                \"columns\": \"name,qty\",\n                \"onMount\": []\n              },\n              \"tree\": {}\n            }\n          ]\n        }\n      },\n      {\n        \"id\": \"page-new\",\n        \"type\": \"page\",\n        \"props\": {\n          \"path\": \"/new\",\n          \"title\": \"New order\",\n          \"onEnter\": []\n        },\n        \"tree\": {\n          \"default\": [\n            {\n              \"id\": \"heading-new\",\n              \"type\": \"heading\",\n              \"props\": {\n                \"text\": \"New order\",\n                \"level\": 2\n              },\n              \"tree\": {}\n            },\n            {\n              \"id\": \"stack-form\",\n              \"type\": \"stack\",\n              \"props\": {\n                \"direction\": \"horizontal\",\n                \"gap\": 8\n              },\n              \"tree\": {\n                \"default\": [\n                  {\n                    \"id\": \"input-1\",\n                    \"type\": \"input\",\n                    \"props\": {\n                      \"value\": \"={{ $state.form.name }}\",\n                      \"model\": \"form.name\",\n                      \"placeholder\": \"Order name\"\n                    },\n                    \"tree\": {}\n                  },\n                  {\n                    \"id\": \"button-add\",\n                    \"type\": \"button\",\n                    \"props\": {\n                      \"label\": \"Add\",\n                      \"variant\": \"primary\",\n                      \"onClick\": [\n                        {\n                          \"kind\": \"webhook\",\n                          \"url\": \"http://localhost:5678/webhook/saveOrder\",\n                          \"method\": \"POST\"\n                        },\n                        {\n                          \"kind\": \"notify\",\n                          \"message\": \"Order added\",\n                          \"type\": \"success\"\n                        },\n                        {\n                          \"kind\": \"navigate\",\n                          \"to\": \"/\"\n                        }\n                      ]\n                    },\n                    \"tree\": {}\n                  }\n                ]\n              }\n            }\n          ]\n        }\n      }\n    ],\n    \"footer\": [\n      {\n        \"id\": \"text-footer\",\n        \"type\": \"text\",\n        \"props\": {\n          \"text\": \"={{ $state.orders ? $state.orders.length + \\\" orders\\\" : \\\"\\\" }}\"\n        },\n        \"tree\": {}\n      }\n    ]\n  }\n}"
      },
      "id": "6a1f0a10-0000-4000-8000-000000000002",
      "name": "UI Builder",
