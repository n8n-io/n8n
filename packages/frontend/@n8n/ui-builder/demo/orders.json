{
	"id": "uiBuilderDemoApp",
	"name": "UI Builder demo — Orders",
	"nodes": [
		{
			"parameters": {
				"content": "## Before you run this\n\nCreate a data table called **orders** with two columns:\n\n| column | type |\n| --- | --- |\n| `name` | String |\n| `qty` | Number |\n\nLeave it empty. The app writes every row itself.",
				"height": 320,
				"width": 300,
				"color": 4
			},
			"id": "6a1f0a10-0000-4000-8000-000000000009",
			"name": "Setup",
