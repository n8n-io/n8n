{
  "name": "@n8n/playwright-janitor",
  "private": true,
  "version": "0.1.0",
  "description": "Static analysis and architecture enforcement for Playwright test suites",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "janitor": "bin/janitor.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist .turbo",
    "build": "tsc",
    "build:unchecked": "tsc --noCheck",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "biome format --write .",
    "format:check": "biome ci .",
		"lint": "oxlint --quiet",
		"lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "testing",
    "static-analysis",
    "architecture",
    "linting"
  ],
  "license": "MIT",
  "dependencies": {
    "@n8n/rules-engine": "workspace:*",
    "@n8n/test-impact": "workspace:*",
    "@n8n/vitest-config": "workspace:*",
    "glob": "^10.0.0",
    "ts-morph": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "ts-morph": "catalog:"
  },
	"devDependencies": {
		"@n8n/eslint-config": "workspace:*",
		"@n8n/oxlint-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
    "typescript": "catalog:typescript",
    "vitest": "catalog:"
  }
}
