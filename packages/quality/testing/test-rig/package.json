{
  "name": "@n8n/test-rig",
  "private": true,
  "version": "0.1.0",
  "description": "Runs n8n stacks under test control: in-process hooks, signals and probes",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "lint": "oxlint --quiet",
    "lint:fix": "oxlint --fix"
  },
  "license": "MIT",
  "dependencies": {
    "@n8n/utils": "workspace:*",
    "n8n-containers": "workspace:*",
    "nanoid": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@n8n/eslint-config": "workspace:*",
    "@n8n/oxlint-config": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:typescript",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
