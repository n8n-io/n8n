{
	"name": "@n8n/efficiency",
	"private": true,
	"scripts": {
		"profile:memory": "node memory/session/cli.mjs",
		"test": "vitest run --config memory/session/__tests__/vitest.config.mjs",
		"test:all": "playwright test",
		"test:images": "playwright test --project='image-efficiency:*'",
		"test:memory": "playwright test --project=memory-baselines",
		"report": "playwright show-report",
		"lint": "oxlint --quiet playwright.config.ts images memory/idle memory/session",
		"typecheck": "tsc --noEmit",
		"format:check": "biome ci playwright.config.ts images memory/idle memory/session --css-formatter-enabled=false && prettier --check memory/session/viewer/style.css"
	},
	"peerDependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@n8n/oxlint-config": "workspace:*",
		"@playwright/test": "catalog:e2e",
		"echarts": "catalog:",
		"gridstack": "catalog:",
		"n8n-playwright": "workspace:*",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:typescript",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"license": "LicenseRef-n8n-sustainable-use"
}
