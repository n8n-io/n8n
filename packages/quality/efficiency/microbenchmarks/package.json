{
  "name": "@n8n/performance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "bench:baseline": "vitest bench --run --reporter=default --reporter=json --outputFile.json=./profiles/benchmark-results.json && node -e \"require('fs').copyFileSync('profiles/benchmark-results.json', 'profiles/baseline.json')\"",
    "bench:compare": "vitest bench --run --reporter=default --reporter=json --outputFile.json=./profiles/benchmark-results.json && node scripts/check-regression.mjs"
  },
  "devDependencies": {
    "@n8n/expression-runtime": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:",
    "n8n-workflow": "workspace:*",
    "typescript": "catalog:typescript"
  },
  "license": "LicenseRef-n8n-sustainable-use"
}
