#!/usr/bin/env node

const { readdirSync, realpathSync, statSync } = require('node:fs');
const { cp } = require('node:fs/promises');
const path = require('node:path');
const pLimit = require('p-limit');
const { packageDir } = require('./common');

const statSafe = (filePath) => {
	try {
		return statSync(filePath);
	} catch {
		return null;
	}
};

const collectStaticFiles = (cwd) => {
	const results = [];

	const walk = (dir, realDir, relBase, includeSchemaJson, visitedRealDirs) => {
		let entries;
		try {
			entries = readdirSync(dir, { withFileTypes: true });
		} catch (error) {
			if (error && (error.code === 'ENOENT' || error.code === 'ENOTDIR')) return;
			throw error;
		}

		for (const entry of entries) {
			if (entry.name.startsWith('.')) continue;

			const fullPath = path.join(dir, entry.name);
			const relPath = `${relBase}/${entry.name}`;
			const isDir =
				entry.isDirectory() || (entry.isSymbolicLink() && Boolean(statSafe(fullPath)?.isDirectory()));

			if (isDir) {
				let nextRealDir = path.join(realDir, entry.name);
				if (entry.isSymbolicLink()) {
					try {
						nextRealDir = realpathSync(fullPath);
					} catch {
						continue;
					}
				}
				if (visitedRealDirs.has(nextRealDir)) continue;
				visitedRealDirs.add(nextRealDir);
				walk(fullPath, nextRealDir, relPath, includeSchemaJson, visitedRealDirs);
			} else if (
				entry.isFile() ||
				(entry.isSymbolicLink() && Boolean(statSafe(fullPath)?.isFile()))
			) {
				if (entry.name.endsWith('.png') || entry.name.endsWith('.svg')) {
					results.push(relPath);
				} else if (
					includeSchemaJson &&
					entry.name.endsWith('.json') &&
					relPath.split('/').slice(1, -1).includes('__schema__')
				) {
					results.push(relPath);
				}
			}
		}
	};

	const visited = new Set();
	for (const [subDir, includeSchemaJson] of [
		['nodes', true],
		['credentials', false],
	]) {
		const startDir = path.join(cwd, subDir);
		let realStartDir = startDir;
		try {
			realStartDir = realpathSync(startDir);
		} catch {
			continue;
		}
		visited.add(realStartDir);
		walk(startDir, realStartDir, subDir, includeSchemaJson, visited);
	}
	return results;
};

const limiter = pLimit(20);
const staticFiles = collectStaticFiles(packageDir);

(async () => {
	await Promise.all(
		staticFiles.map((filePath) =>
			limiter(() => {
				return cp(filePath, `dist/${filePath}`, { recursive: true });
			}),
		),
	);
})();
