{
  "reporters": ["json", "html"],
  "gitignore": true,
  "ignore": [
    "**/__snapshots__/**",
    "**/*.snap",
    "**/fixtures/**",
    "**/locales/**",
    "**/i18n/**",
    "**/*.generated.*",
    "**/__schema__/**",
    "**/cassettes/**",
