# Example env for comparing AI workflow builders (Instance AI, Claude Code + n8n MCP,
# Codex + n8n MCP) on a local instance.
#
# Copy to `.env.ai-surfaces` (gitignored) and fill in the values that you need.
# Never commit keys. The testmax-n8n-ai skill reads the files in this
# order, from low to high priority: .env.local, .env.ai-surfaces, the shell
# environment. Empty values are ignored, so keys that are already in .env.local
# work without a change. Set AI_SURFACES_ENV to use a file in a different place.
#
# See .agents/skills/testmax-n8n-ai/SKILL.md for how the values are used.

# --- n8n ---------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_EVAL_EMAIL=nathan@n8n.io
N8N_EVAL_PASSWORD=PlaywrightTest123
# Optional. The MCP key of the user above (Settings > MCP). When set, the skill
# does not need the cached token and never asks to rotate the key.
N8N_MCP_TOKEN=

# --- Run defaults --------------------------------------------------------------
COMPARE_BUILDERS=iai,claude,codex
# container (Docker) or clean (Claude only, no Docker)
COMPARE_ISOLATION=container
COMPARE_RUNS_DIR=/tmp/builder-compare
# 1 runs the builders at the same time. 0 runs them one at a time.
COMPARE_PARALLEL=1
# 1 opens a local page that shows the runs live and then the report. 0 turns it off.
COMPARE_LIVE=1
# 1 also opens the Instance AI thread in the browser and a terminal window for
# each CLI builder.
COMPARE_LIVE_WINDOWS=0
# 1 records a video of the Instance AI thread for the replay on the page.
COMPARE_RECORD=1
# interactive records the real terminal screen of Claude Code and Codex.
# headless uses `claude -p` and `codex exec` and has no screen recording.
COMPARE_CLI_MODE=interactive

# --- Claude Code + n8n MCP -----------------------------------------------------
# Empty model uses the Claude Code default.
CLAUDE_MODEL=
# none: Claude Code has only the n8n tools. default: it also has its built-in tools,
# such as Bash, Read, Write and WebFetch, and uses all of them without a question,
# like Codex in the same container. Clean isolation always uses none.
COMPARE_CLAUDE_TOOLS=none
# Falls back to ANTHROPIC_API_KEY.
CLAUDE_API_KEY=

# --- Codex + n8n MCP -----------------------------------------------------------
# Empty model uses the Codex default.
CODEX_MODEL=
# Falls back to OPENAI_API_KEY.
CODEX_API_KEY=

# --- Instance AI cost (LangSmith) ----------------------------------------------
# The n8n instance must trace to the same project (LANGSMITH_TRACING=true).
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=instance-ai
